-3","page_id":"/features/ts-module-node18","type":"heading","tags":[],"url":"/features/ts-module-node18#gotchas","content":"Gotchas"},"3310":{"id":"/features/ts-module-node18-4","page_id":"/features/ts-module-node18","type":"heading","tags":[],"url":"/features/ts-module-node18#sources","content":"Primary sources"},"3311":{"id":"/features/ts-module-node18-5","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#stable-node-18-module-mode","content":"The `node18` module option provides fixed module checking and emission rules for the Node.js 18 model."},"3312":{"id":"/features/ts-module-node18-6","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#what-it-does","content":"`module: \"node18\"` pairs the corresponding Node module-resolution behavior with a non-floating ruleset. It allows import assertions and rejects CommonJS `require()` calls targeting ECMAScript modules. The release notes contrast its behavior with `nodenext`."},"3313":{"id":"/features/ts-module-node18-7","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#gotchas","content":"The fixed mode does not acquire later NodeNext behavior. Projects that need Node's synchronous ECMAScript-module loading rules use the floating `nodenext` mode instead."},"3314":{"id":"/features/ts-module-node18-8","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"Announcing TypeScript 5.8"},"3315":{"id":"/features/ts-module-node18-9","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"TypeScript release announcement, published 2025-02-28, reviewed 2026-07-26"},"3316":{"id":"/features/ts-module-node18-10","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"TypeScript 5.8 release notes: module node18"},"3317":{"id":"/features/ts-module-node18-11","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3318":{"id":"/features/ts-module-node18-12","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"TypeScript 5.8 stable release"},"3319":{"id":"/features/ts-module-node18-13","page_id":"/features/ts-module-node18","tags":[],"type":"text","url":"/features/ts-module-node18#sources","content":"Release tag, published 2025-02-28, reviewed 2026-07-23"},"3320":{"id":"/features/ts-module-node20","page_id":"/features/ts-module-node20","type":"page","content":"Stable Node 20 module mode","breadcrumbs":["typescript","TS 5.9"],"tags":[],"url":"/features/ts-module-node20"},"3321":{"id":"/features/ts-module-node20-0","page_id":"/features/ts-module-node20","type":"heading","tags":[],"url":"/features/ts-module-node20#stable-node-20-module-mode","content":"Stable Node 20 module mode"},"3322":{"id":"/features/ts-module-node20-1","page_id":"/features/ts-module-node20","type":"heading","tags":[],"url":"/features/ts-module-node20#what-it-does","content":"What it does"},"3323":{"id":"/features/ts-module-node20-2","page_id":"/features/ts-module-node20","type":"heading","tags":[],"url":"/features/ts-module-node20#before--after","content":"Before / after"},"3324":{"id":"/features/ts-module-node20-3","page_id":"/features/ts-module-node20","type":"heading","tags":[],"url":"/features/ts-module-node20#gotchas","content":"Gotchas"},"3325":{"id":"/features/ts-module-node20-4","page_id":"/features/ts-module-node20","type":"heading","tags":[],"url":"/features/ts-module-node20#sources","content":"Primary sources"},"3326":{"id":"/features/ts-module-node20-5","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#stable-node-20-module-mode","content":"The `node20` module option fixes module checking and resolution to the Node.js 20 model."},"3327":{"id":"/features/ts-module-node20-6","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#what-it-does","content":"`module: \"node20\"` permits compatible CommonJS `require()` calls to ECMAScript modules and rejects import assertions. Unless configured separately, it implies an `es2023` target. The release notes contrast these rules and defaults with NodeNext."},"3328":{"id":"/features/ts-module-node20-7","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#gotchas","content":"The fixed mode does not acquire future NodeNext behavior and does not imply the floating `esnext` target. Projects need `nodenext` when their runtime contract follows later Node module semantics."},"3329":{"id":"/features/ts-module-node20-8","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"Announcing TypeScript 5.9"},"3330":{"id":"/features/ts-module-node20-9","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"TypeScript release announcement, published 2025-08-01, reviewed 2026-07-26"},"3331":{"id":"/features/ts-module-node20-10","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"TypeScript 5.9 release notes: module node20"},"3332":{"id":"/features/ts-module-node20-11","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3333":{"id":"/features/ts-module-node20-12","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"TypeScript 5.9 stable release"},"3334":{"id":"/features/ts-module-node20-13","page_id":"/features/ts-module-node20","tags":[],"type":"text","url":"/features/ts-module-node20#sources","content":"Release tag, reviewed 2026-07-23"},"3335":{"id":"/features/ts-module-preserve","page_id":"/features/ts-module-preserve","type":"page","content":"Preserve module mode","breadcrumbs":["typescript","TS 5.4"],"tags":[],"url":"/features/ts-module-preserve"},"3336":{"id":"/features/ts-module-preserve-0","page_id":"/features/ts-module-preserve","type":"heading","tags":[],"url":"/features/ts-module-preserve#preserve-module-mode","content":"Preserve module mode"},"3337":{"id":"/features/ts-module-preserve-1","page_id":"/features/ts-module-preserve","type":"heading","tags":[],"url":"/features/ts-module-preserve#what-it-does","content":"What it does"},"3338":{"id":"/features/ts-module-preserve-2","page_id":"/features/ts-module-preserve","type":"heading","tags":[],"url":"/features/ts-module-preserve#before--after","content":"Before / after"},"3339":{"id":"/features/ts-module-preserve-3","page_id":"/features/ts-module-preserve","type":"heading","tags":[],"url":"/features/ts-module-preserve#related","content":"Related"},"3340":{"id":"/features/ts-module-preserve-4","page_id":"/features/ts-module-preserve","type":"heading","tags":[],"url":"/features/ts-module-preserve#sources","content":"Primary sources"},"3341":{"id":"/features/ts-module-preserve-5","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#preserve-module-mode","content":"`module: preserve` retains each ECMAScript import or export while emitting TypeScript import assignments as `require()` calls."},"3342":{"id":"/features/ts-module-preserve-6","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#what-it-does","content":"The mode implies `moduleResolution: bundler`, `esModuleInterop`, and `resolveJsonModule`. Import syntax selects the corresponding `import` or `require` condition during package resolution, independent of the containing file extension."},"3343":{"id":"/features/ts-module-preserve-7","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#related","content":"ts-bundler-commonjs"},"3344":{"id":"/features/ts-module-preserve-8","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"Announcing TypeScript 5.4"},"3345":{"id":"/features/ts-module-preserve-9","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"TypeScript release announcement, published 2024-03-06, reviewed 2026-07-26"},"3346":{"id":"/features/ts-module-preserve-10","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"TypeScript 5.4 release notes: preserve module mode"},"3347":{"id":"/features/ts-module-preserve-11","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3348":{"id":"/features/ts-module-preserve-12","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"TypeScript 5.4 stable release"},"3349":{"id":"/features/ts-module-preserve-13","page_id":"/features/ts-module-preserve","tags":[],"type":"text","url":"/features/ts-module-preserve#sources","content":"Release tag, published 2024-03-06, reviewed 2026-07-26"},"3350":{"id":"/features/ts-module-resolution-deprecations","page_id":"/features/ts-module-resolution-deprecations","type":"page","content":"Legacy module-resolution deprecations","breadcrumbs":["typescript","TS 6.0"],"tags":[],"url":"/features/ts-module-resolution-deprecations"},"3351":{"id":"/features/ts-module-resolution-deprecations-0","page_id":"/features/ts-module-resolution-deprecations","type":"heading","tags":[],"url":"/features/ts-module-resolution-deprecations#legacy-module-resolution-deprecations","content":"Legacy module-resolution deprecations"},"3352":{"id":"/features/ts-module-resolution-deprecations-1","page_id":"/features/ts-module-resolution-deprecations","type":"heading","tags":[],"url":"/features/ts-module-resolution-deprecations#what-it-does","content":"What it does"},"3353":{"id":"/features/ts-module-resolution-deprecations-2","page_id":"/features/ts-module-resolution-deprecations","type":"heading","tags":[],"url":"/features/ts-module-resolution-deprecations#migration","content":"Migration"},"3354":{"id":"/features/ts-module-resolution-deprecations-3","page_id":"/features/ts-module-resolution-deprecations","type":"heading","tags":[],"url":"/features/ts-module-resolution-deprecations#compatibility","content":"Compatibility"},"3355":{"id":"/features/ts-module-resolution-deprecations-4","page_id":"/features/ts-module-resolution-deprecations","type":"heading","tags":[],"url":"/features/ts-module-resolution-deprecations#sources","content":"Primary sources"},"3356":{"id":"/features/ts-module-resolution-deprecations-5","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#legacy-module-resolution-deprecations","content":"Node 10 resolution, Classic resolution, and `baseUrl` produce deprecation diagnostics."},"3357":{"id":"/features/ts-module-resolution-deprecations-6","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#what-it-does","content":"The `node` alias and `node10` value select the deprecated Node 10 strategy. `classic` is also deprecated. `baseUrl` remains usable but is deprecated as a general lookup root; `paths` mappings no longer require it as a prefix. The stable compiler checks all three settings."},"3358":{"id":"/features/ts-module-resolution-deprecations-7","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#migration","content":"Use NodeNext for code executed directly by Node or bundler resolution for a compatible downstream resolver. Remove `baseUrl` and place its prefix in each `paths` target, or add an explicit catch-all mapping when lookup-root behavior is intentional."},"3359":{"id":"/features/ts-module-resolution-deprecations-8","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#compatibility","content":"The stable compiler still runs these options when `ignoreDeprecations: \"6.0\"` suppresses their diagnostics. This resolves the handbook sentence that labels Classic resolution as removed. The stable tag's deprecation code keeps the option in the suppressible branch."},"3360":{"id":"/features/ts-module-resolution-deprecations-9","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"Announcing TypeScript 6.0"},"3361":{"id":"/features/ts-module-resolution-deprecations-10","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript release announcement, published 2026-03-23, reviewed 2026-07-23"},"3362":{"id":"/features/ts-module-resolution-deprecations-11","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript 6.0 release notes: module-resolution deprecations § deprecated---baseurl"},"3363":{"id":"/features/ts-module-resolution-deprecations-12","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript release notes, reviewed 2026-07-23"},"3364":{"id":"/features/ts-module-resolution-deprecations-13","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript stable compiler deprecation checks"},"3365":{"id":"/features/ts-module-resolution-deprecations-14","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"Compiler source, reviewed 2026-07-23"},"3366":{"id":"/features/ts-module-resolution-deprecations-15","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript stable compiler deprecation checks § L4432-L4474"},"3367":{"id":"/features/ts-module-resolution-deprecations-16","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"Compiler source, reviewed 2026-07-23"},"3368":{"id":"/features/ts-module-resolution-deprecations-17","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"TypeScript 6.0 stable release"},"3369":{"id":"/features/ts-module-resolution-deprecations-18","page_id":"/features/ts-module-resolution-deprecations","tags":[],"type":"text","url":"/features/ts-module-resolution-deprecations#sources","content":"Release tag, published 2026-03-23, reviewed 2026-07-23"},"3370":{"id":"/features/ts-native-compiler-api","page_id":"/features/ts-native-compiler-api","type":"page","content":"Native compiler and API transition","breadcrumbs":["typescript","TS 7.0"],"tags":[],"url":"/features/ts-native-compiler-api"},"3371":{"id":"/features/ts-native-compiler-api-0","page_id":"/features/ts-native-compiler-api","type":"heading","tags":[],"url":"/features/ts-native-compiler-api#native-compiler-and-api-transition","content":"Native compiler and API transition"},"3372":{"id":"/features/ts-native-compiler-api-1","page_id":"/features/ts-native-compiler-api","type":"heading","tags":[],"url":"/features/ts-native-compiler-api#what-it-does","content":"What it does"},"3373":{"id":"/features/ts-native-compiler-api-2","page_id":"/features/ts-native-compiler-api","type":"heading","tags":[],"url":"/features/ts-native-compiler-api#migration","content":"Migration"},"3374":{"id":"/features/ts-native-compiler-api-3","page_id":"/features/ts-native-compiler-api","type":"heading","tags":[],"url":"/features/ts-native-compiler-api#compatibility","content":"Compatibility"},"3375":{"id":"/features/ts-native-compiler-api-4","page_id":"/features/ts-native-compiler-api","type":"heading","tags":[],"url":"/features/ts-native-compiler-api#sources","content":"Primary sources"},"3376":{"id":"/features/ts-native-compiler-api-5","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#native-compiler-and-api-transition","content":"The `typescript` package now supplies the Go-based native compiler and does not expose a programmatic compiler API."},"3377":{"id":"/features/ts-native-compiler-api-6","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#what-it-does","content":"The package installs the native `tsc` executable for command-line checking and emit. Tools that import compiler functions cannot use this release as a drop-in API replacement. The compatibility package `@typescript/typescript6` exposes `tsc6` and re-exports the earlier JavaScript API for side-by-side use."},"3378":{"id":"/features/ts-native-compiler-api-7","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#migration","content":"Run the native executable for project builds. Keep API-dependent tools on `@typescript/typescript6`, using an alias when a tool's peer dependency imports the `typescript` package name directly."},"3379":{"id":"/features/ts-native-compiler-api-8","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#compatibility","content":"Compiler-API consumers require the compatibility package or an updated integration. Command-line-only projects can use the native package directly."},"3380":{"id":"/features/ts-native-compiler-api-9","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#sources","content":"Announcing TypeScript 7.0 § running-side-by-side-with-typescript-60"},"3381":{"id":"/features/ts-native-compiler-api-10","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#sources","content":"TypeScript release announcement, published 2026-07-08, reviewed 2026-07-23"},"3382":{"id":"/features/ts-native-compiler-api-11","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#sources","content":"typescript/v7.0.2 stable release"},"3383":{"id":"/features/ts-native-compiler-api-12","page_id":"/features/ts-native-compiler-api","tags":[],"type":"text","url":"/features/ts-native-compiler-api#sources","content":"Release tag, published 2026-07-08, reviewed 2026-07-23"},"3384":{"id":"/features/ts-native-watch-mode","page_id":"/features/ts-native-watch-mode","type":"page","content":"Native watch mode","breadcrumbs":["typescript","TS 7.0"],"tags":[],"url":"/features/ts-native-watch-mode"},"3385":{"id":"/features/ts-native-watch-mode-0","page_id":"/features/ts-native-watch-mode","type":"heading","tags":[],"url":"/features/ts-native-watch-mode#native-watch-mode","content":"Native watch mode"},"3386":{"id":"/features/ts-native-watch-mode-1","page_id":"/features/ts-native-watch-mode","type":"heading","tags":[],"url":"/features/ts-native-watch-mode#what-it-does","content":"What it does"},"3387":{"id":"/features/ts-native-watch-mode-2","page_id":"/features/ts-native-watch-mode","type":"heading","tags":[],"url":"/features/ts-native-watch-mode#sources","content":"Primary sources"},"3388":{"id":"/features/ts-native-watch-mode-3","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#native-watch-mode","content":"The native compiler uses a rebuilt cross-platform file-watching implementation for `--watch`."},"3389":{"id":"/features/ts-native-watch-mode-4","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#what-it-does","content":"The watcher is a Go port derived from Parcel's watcher architecture with small platform assembly shims. It separates detecting filesystem changes from the compiler's decision about what to watch and why."},"3390":{"id":"/features/ts-native-watch-mode-5","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#sources","content":"Announcing TypeScript 7.0 § improved-watch-mode"},"3391":{"id":"/features/ts-native-watch-mode-6","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#sources","content":"TypeScript release announcement, published 2026-07-08, reviewed 2026-07-23"},"3392":{"id":"/features/ts-native-watch-mode-7","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#sources","content":"typescript/v7.0.2 stable release"},"3393":{"id":"/features/ts-native-watch-mode-8","page_id":"/features/ts-native-watch-mode","tags":[],"type":"text","url":"/features/ts-native-watch-mode#sources","content":"Release tag, published 2026-07-08, reviewed 2026-07-23"},"3394":{"id":"/features/ts-never-initialized-captures","page_id":"/features/ts-never-initialized-captures","type":"page","content":"Never-initialized captured variables","breadcrumbs":["typescript","TS 5.7"],"tags":[],"url":"/features/ts-never-initialized-captures"},"3395":{"id":"/features/ts-never-initialized-captures-0","page_id":"/features/ts-never-initialized-captures","type":"heading","tags":[],"url":"/features/ts-never-initialized-captures#never-initialized-captured-variables","content":"Never-initialized captured variables"},"3396":{"id":"/features/ts-never-initialized-captures-1","page_id":"/features/ts-never-initialized-captures","type":"heading","tags":[],"url":"/features/ts-never-initialized-captures#what-it-does","content":"What it does"},"3397":{"id":"/features/ts-never-initialized-captures-2","page_id":"/features/ts-never-initialized-captures","type":"heading","tags":[],"url":"/features/ts-never-initialized-captures#before--after","content":"Before / after"},"3398":{"id":"/features/ts-never-initialized-captures-3","page_id":"/features/ts-never-initialized-captures","type":"heading","tags":[],"url":"/features/ts-never-initialized-captures#migration","content":"Migration"},"3399":{"id":"/features/ts-never-initialized-captures-4","page_id":"/features/ts-never-initialized-captures","type":"heading","tags":[],"url":"/features/ts-never-initialized-captures#sources","content":"Primary sources"},"3400":{"id":"/features/ts-never-initialized-captures-5","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#never-initialized-captured-variables","content":"Captured variables that receive no assignment are reported when read from nested functions."},"3401":{"id":"/features/ts-never-initialized-captures-6","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#what-it-does","content":"The checker remains permissive when a variable may have been assigned before the nested function runs. It errors when analysis finds no assignment anywhere, closing a gap caused by optimistic assumptions about callback timing."},"3402":{"id":"/features/ts-never-initialized-captures-7","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#migration","content":"Assign the variable on the intended path, move the read after initialization, or include `undefined` and handle the absent value. The diagnostic identifies the captured read."},"3403":{"id":"/features/ts-never-initialized-captures-8","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"Announcing TypeScript 5.7"},"3404":{"id":"/features/ts-never-initialized-captures-9","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"TypeScript release announcement, published 2024-11-22, reviewed 2026-07-26"},"3405":{"id":"/features/ts-never-initialized-captures-10","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"TypeScript 5.7 release notes: never-initialized variables"},"3406":{"id":"/features/ts-never-initialized-captures-11","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3407":{"id":"/features/ts-never-initialized-captures-12","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"TypeScript 5.7 stable release"},"3408":{"id":"/features/ts-never-initialized-captures-13","page_id":"/features/ts-never-initialized-captures","tags":[],"type":"text","url":"/features/ts-never-initialized-captures#sources","content":"Release tag, published 2024-11-22, reviewed 2026-07-24"},"3409":{"id":"/features/ts-no-check","page_id":"/features/ts-no-check","type":"page","content":"noCheck compiler option","breadcrumbs":["typescript","TS 5.6"],"tags":[],"url":"/features/ts-no-check"},"3410":{"id":"/features/ts-no-check-0","page_id":"/features/ts-no-check","type":"heading","tags":[],"url":"/features/ts-no-check#nocheck-compiler-option","content":"noCheck compiler option"},"3411":{"id