res/regexp-modifiers"},"1844":{"id":"/features/regexp-modifiers-0","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#regexp-modifiers","content":"RegExp modifiers"},"1845":{"id":"/features/regexp-modifiers-1","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#what-it-does","content":"What it does"},"1846":{"id":"/features/regexp-modifiers-2","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#before--after","content":"Before / after"},"1847":{"id":"/features/regexp-modifiers-3","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#gotchas","content":"Gotchas"},"1848":{"id":"/features/regexp-modifiers-4","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#related","content":"Related"},"1849":{"id":"/features/regexp-modifiers-5","page_id":"/features/regexp-modifiers","type":"heading","tags":[],"url":"/features/regexp-modifiers#sources","content":"Primary sources"},"1850":{"id":"/features/regexp-modifiers-6","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#regexp-modifiers","content":"Modifier groups enable or disable selected regular-expression flags for a nested pattern."},"1851":{"id":"/features/regexp-modifiers-7","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#what-it-does","content":"The form `(?ims-ims:subexpression)` changes the `i`, `m`, and `s` flags only within its group. Letters before `-` enable flags and letters after it disable flags, with no flag appearing twice."},"1852":{"id":"/features/regexp-modifiers-8","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#gotchas","content":"Only `i`, `m`, and `s` are valid modifier letters. The outer expression's other flags, including `u` or `v`, cannot be changed inside a modifier group."},"1853":{"id":"/features/regexp-modifiers-9","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#related","content":"regexp-escape"},"1854":{"id":"/features/regexp-modifiers-10","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"Regular Expression Pattern Modifiers for ECMAScript § syntax"},"1855":{"id":"/features/regexp-modifiers-11","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"1856":{"id":"/features/regexp-modifiers-12","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"ECMAScript 2025: RegExp patterns"},"1857":{"id":"/features/regexp-modifiers-13","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"ECMA-262 specification, published 2025-06-25, reviewed 2026-07-23"},"1858":{"id":"/features/regexp-modifiers-14","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"TC39 notes: RegExp modifiers for Stage 4"},"1859":{"id":"/features/regexp-modifiers-15","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"Committee notes, published 2024-10-08, reviewed 2026-07-23"},"1860":{"id":"/features/regexp-modifiers-16","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"Ecma International approves new standards"},"1861":{"id":"/features/regexp-modifiers-17","page_id":"/features/regexp-modifiers","tags":[],"type":"text","url":"/features/regexp-modifiers#sources","content":"Ecma General Assembly record, published 2025-06-26, reviewed 2026-07-23"},"1862":{"id":"/features/regexp-named-capture-groups","page_id":"/features/regexp-named-capture-groups","type":"page","content":"RegExp named capture groups","breadcrumbs":["ecmascript","ES2018"],"tags":[],"url":"/features/regexp-named-capture-groups"},"1863":{"id":"/features/regexp-named-capture-groups-0","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#regexp-named-capture-groups","content":"RegExp named capture groups"},"1864":{"id":"/features/regexp-named-capture-groups-1","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#what-it-does","content":"What it does"},"1865":{"id":"/features/regexp-named-capture-groups-2","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#before--after","content":"Before / after"},"1866":{"id":"/features/regexp-named-capture-groups-3","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#gotchas","content":"Gotchas"},"1867":{"id":"/features/regexp-named-capture-groups-4","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#support","content":"Support"},"1868":{"id":"/features/regexp-named-capture-groups-5","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#related","content":"Related"},"1869":{"id":"/features/regexp-named-capture-groups-6","page_id":"/features/regexp-named-capture-groups","type":"heading","tags":[],"url":"/features/regexp-named-capture-groups#sources","content":"Primary sources"},"1870":{"id":"/features/regexp-named-capture-groups-7","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#regexp-named-capture-groups","content":"A capture group written `(?<name>…)` is readable through `match.groups.name`, `\\k<name>`, and `$<name>`."},"1871":{"id":"/features/regexp-named-capture-groups-8","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#what-it-does","content":"`Atom` accepts `( GroupSpecifier Disjunction )`, and `AtomEscape` accepts `\\k GroupName` when the pattern's `[+N]` parameter is set. `RegExpBuiltinExec` creates a `groups` property on every result array: an `ObjectCreate(null)` when the pattern contains any `GroupName` and `undefined` when it does not, then stores each named capture under its `RegExpIdentifierName` alongside the numbered slot. `GetSubstitution` recognises `$<`, scans to the next `>`, and substitutes `Get(namedCaptures, groupName)` or the empty string when that capture is `undefined`."},"1872":{"id":"/features/regexp-named-capture-groups-9","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#what-it-does","content":"The proposal's stated problem is that a numbered group carries no indication of what it captured, so reordering the groups forces every reference to be renumbered. It also adds a trailing `groups` argument to a replacer function, and chose `$<name>` over `${name}` in replacement strings to mirror the group declaration and stay visually distinct from template literals."},"1873":{"id":"/features/regexp-named-capture-groups-10","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#gotchas","content":"The `groups` object has a `null` prototype, so `groups.toString` is `undefined` and `groups.hasOwnProperty` cannot be called; the proposal put the names on a separate object precisely to keep them from colliding with `length`, `index`, and `input` on the result array. The property exists whatever the pattern looks like: `RegExpBuiltinExec` always performs the `CreateDataProperty` step, so `\"groups\" in /\\d+/.exec(\"7\")` is `true` while the value is `undefined`."},"1874":{"id":"/features/regexp-named-capture-groups-11","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#gotchas","content":"Named groups also keep their numbers, and the proposal shows `\\k<part>` and `\\1` referring to the same capture inside one pattern. It notes the one refactoring hazard: `\\k<foo>` used to match the literal text `k<foo>` in a pattern without the `u` flag, and it keeps doing so only while that pattern declares no named group at all. Backreferences to names are also what `\\k GroupName` needs the `[+N]` parameter for."},"1875":{"id":"/features/regexp-named-capture-groups-12","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#support","content":"V8 enabled the syntax by default in 6.4, whose example reads `result.groups.year`, `result.groups.month`, and `result.groups.day` from a date pattern."},"1876":{"id":"/features/regexp-named-capture-groups-13","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#related","content":"RegExp match indices mirrors this `groups` object under `indices.groups`, giving each named capture its offset pair."},"1877":{"id":"/features/regexp-named-capture-groups-14","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#related","content":"Duplicate named capture groups later dropped the requirement that every name in a pattern be distinct."},"1878":{"id":"/features/regexp-named-capture-groups-15","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"RegExp Named Capture Groups: High Level API"},"1879":{"id":"/features/regexp-named-capture-groups-16","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1880":{"id":"/features/regexp-named-capture-groups-17","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"RegExp Named Capture Groups: Backreferences"},"1881":{"id":"/features/regexp-named-capture-groups-18","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1882":{"id":"/features/regexp-named-capture-groups-19","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"RegExp Named Capture Groups: Replacement targets"},"1883":{"id":"/features/regexp-named-capture-groups-20","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1884":{"id":"/features/regexp-named-capture-groups-21","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"RegExp Named Capture Groups: Overlapping group names"},"1885":{"id":"/features/regexp-named-capture-groups-22","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1886":{"id":"/features/regexp-named-capture-groups-23","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"RegExp Named Capture Groups: Backwards compatibility of new syntax"},"1887":{"id":"/features/regexp-named-capture-groups-24","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1888":{"id":"/features/regexp-named-capture-groups-25","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMAScript 2018: Patterns"},"1889":{"id":"/features/regexp-named-capture-groups-26","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"1890":{"id":"/features/regexp-named-capture-groups-27","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMAScript 2018: RegExpBuiltinExec"},"1891":{"id":"/features/regexp-named-capture-groups-28","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"1892":{"id":"/features/regexp-named-capture-groups-29","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMAScript 2018: Runtime Semantics: GetSubstitution"},"1893":{"id":"/features/regexp-named-capture-groups-30","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"1894":{"id":"/features/regexp-named-capture-groups-31","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 notes: RegExp named captures status update"},"1895":{"id":"/features/regexp-named-capture-groups-32","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"Committee notes, published 2017-11-28, reviewed 2026-07-26"},"1896":{"id":"/features/regexp-named-capture-groups-33","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"TC39 notes: RegExp status update, January 2018"},"1897":{"id":"/features/regexp-named-capture-groups-34","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"Committee notes, published 2018-01-23, reviewed 2026-07-26"},"1898":{"id":"/features/regexp-named-capture-groups-35","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"V8 release v6.4: ECMAScript language features"},"1899":{"id":"/features/regexp-named-capture-groups-36","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"Engine record, published 2017-12-19, reviewed 2026-07-26"},"1900":{"id":"/features/regexp-named-capture-groups-37","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"Results of the 115th Ecma General Assembly held in Geneva, June 27, 2018"},"1901":{"id":"/features/regexp-named-capture-groups-38","page_id":"/features/regexp-named-capture-groups","tags":[],"type":"text","url":"/features/regexp-named-capture-groups#sources","content":"Ecma General Assembly record, published 2018-06-27, reviewed 2026-07-26"},"1902":{"id":"/features/regexp-unicode-property-escapes","page_id":"/features/regexp-unicode-property-escapes","type":"page","content":"RegExp Unicode property escapes","breadcrumbs":["ecmascript","ES2018"],"tags":[],"url":"/features/regexp-unicode-property-escapes"},"1903":{"id":"/features/regexp-unicode-property-escapes-0","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#regexp-unicode-property-escapes","content":"RegExp Unicode property escapes"},"1904":{"id":"/features/regexp-unicode-property-escapes-1","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#what-it-does","content":"What it does"},"1905":{"id":"/features/regexp-unicode-property-escapes-2","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#before--after","content":"Before / after"},"1906":{"id":"/features/regexp-unicode-property-escapes-3","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#gotchas","content":"Gotchas"},"1907":{"id":"/features/regexp-unicode-property-escapes-4","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#support","content":"Support"},"1908":{"id":"/features/regexp-unicode-property-escapes-5","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#related","content":"Related"},"1909":{"id":"/features/regexp-unicode-property-escapes-6","page_id":"/features/regexp-unicode-property-escapes","type":"heading","tags":[],"url":"/features/regexp-unicode-property-escapes#sources","content":"Primary sources"},"1910":{"id":"/features/regexp-unicode-property-escapes-7","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#regexp-unicode-property-escapes","content":"`\\p{…}` and `\\P{…}` match code points by their Unicode character-database properties inside a Unicode-mode pattern."},"1911":{"id":"/features/regexp-unicode-property-escapes-8","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#what-it-does","content":"`CharacterClassEscape` gains `p{ UnicodePropertyValueExpression }` and `P{ … }`, both guarded by the `[+U]` parameter, and the expression is either `UnicodePropertyName=UnicodePropertyValue` or a lone name or value. `\\p{…}` returns the code points whose database definition carries that property and value, and `\\P{…}` returns the complement. `UnicodeMatchProperty` resolves a name or alias against two fixed tables and requires implementations to reject every other spelling, so `Script_Extensions` and `scx` are valid while `script_extensions` and `Scx` are not."},"1912":{"id":"/features/regexp-unicode-property-escapes-9","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#what-it-does","content":"The proposal's target is the maintenance cost of hand-written ranges: a Unicode-aware class had to be generated at build time, shipped as pattern text, and regenerated whenever the Unicode Standard changed. With the escapes, an engine data update reaches existing patterns with no code change, and the lone-value form doubles as shorthand for `General_Category`, so `\\p{Letter}` means `\\p{General_Category=Letter}`."},"1913":{"id":"/features/regexp-unicode-property-escapes-10","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#gotchas","content":"The escapes exist only under `u`, because the grammar productions carry `[+U]`. Without that flag `\\p` stays an identity escape for the letter `p`, so `/^\\p{Letter}+$/` matches the nine-character string `p{Letter}` and not `p`. The proposal explains that ECMAScript 2015 already made `\\p` throw under `u`, which is what left the syntax free to redefine."},"1914":{"id":"/features/regexp-unicode-property-escapes-11","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#gotchas","content":"Spelling is exact and mismatches are early errors: `new RegExp(\"\\\\p{letter}\", \"u\")` throws a `SyntaxError` for the lowercased property name, because only the canonical names and aliases in the two tables resolve. `\\p{Number}` is also wider than `\\d`, which stays the ten ASCII digits, so the two disagree on `٣`; the proposal's Unicode-aware replacement for `\\d` is `\\p{Decimal_Number}` for that reason."},"1915":{"id":"/features/regexp-unicode-property-escapes-12","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#support","content":"V8 enabled the escapes by default in 6.4, whose example tests `/\\p{Script_Extensions=Greek}/u` against a Greek letter."},"1916":{"id":"/features/regexp-unicode-property-escapes-13","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#related","content":"RegExp v flag extends the same `\\p{…}` syntax to properties whose members are strings rather than single code points."},"1917":{"id":"/features/regexp-unicode-property-escapes-14","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"ECMAScript proposal: Unicode property escapes in regular expressions"},"1918":{"id":"/features/regexp-unicode-property-escapes-15","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1919":{"id":"/features/regexp-unicode-property-escapes-16","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"Unicode property escapes: Motivation"},"1920":{"id":"/features/regexp-unicode-property-escapes-17","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1921":{"id":"/features/regexp-unicode-property-escapes-18","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"Unicode property escapes: High-level API"},"1922":{"id":"/features/regexp-unicode-property-escapes-19","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1923":{"id":"/features/regexp-unicode-property-escapes-20","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"Unicode property escapes: What about backwards compatibility?"},"1924":{"id":"/features/regexp-unicode-property-escapes-21","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1925":{"id":"/features/regexp-unicode-property-escapes-22","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"Unicode property escapes: Unicode-aware version of \\d"},"1926":{"id":"/features/regexp-unicode-property-escapes-23","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1927":{"id":"/features/regexp-unicode-property-escapes-24","page_id":"/features/regexp-unicode-property-escapes","tags":[],"type":"text","url":"/features/regexp-unicode-property-escapes#sources","content":"ECMAScript 2018: Patterns"},"1928":{"id":"/features/regexp-unicode-property-escapes-25","page_id":"/fe