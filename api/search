ass-features","page_id":"/features/static-class-features","type":"page","content":"Static class fields and private static methods","breadcrumbs":["ecmascript","ES2022"],"tags":[],"url":"/features/static-class-features"},"2100":{"id":"/features/static-class-features-0","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#static-class-fields-and-private-static-methods","content":"Static class fields and private static methods"},"2101":{"id":"/features/static-class-features-1","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#what-it-does","content":"What it does"},"2102":{"id":"/features/static-class-features-2","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#before--after","content":"Before / after"},"2103":{"id":"/features/static-class-features-3","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#gotchas","content":"Gotchas"},"2104":{"id":"/features/static-class-features-4","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#related","content":"Related"},"2105":{"id":"/features/static-class-features-5","page_id":"/features/static-class-features","type":"heading","tags":[],"url":"/features/static-class-features#sources","content":"Primary sources"},"2106":{"id":"/features/static-class-features-6","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#static-class-fields-and-private-static-methods","content":"The `static` modifier applies to a field declaration and to a `#`-named method, placing both on the constructor itself."},"2107":{"id":"/features/static-class-features-7","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#what-it-does","content":"`ClassElement` admits `static MethodDefinition` and `static FieldDefinition ;`, and the name of either may be a `PrivateIdentifier`. Class definition evaluation adds every static private method to the constructor `F` and then walks the static elements in source order, calling `DefineField(F, …)` for each static field. `this` inside a static field initializer is that constructor, so `static x = this.name` reads the class name. The three class-features proposals were presented together, and this one's repository now records only the merge into class fields."},"2108":{"id":"/features/static-class-features-8","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#gotchas","content":"Static private state belongs to one constructor object. Because the definition installs it on `F` alone and a read of an absent private name throws, a static method that reaches for `#cache` through `this` throws a `TypeError` when it is invoked as `Subclass.method()`, even though the subclass inherits the method. Two names are rejected outright: a static `FieldDefinition` whose `PropName` is `prototype` or `constructor` is a Syntax Error, so `static prototype = 1` fails to parse rather than throwing at run time."},"2109":{"id":"/features/static-class-features-9","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#related","content":"class-fields"},"2110":{"id":"/features/static-class-features-10","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#related","content":"private-methods-and-accessors"},"2111":{"id":"/features/static-class-features-11","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#related","content":"class-static-block"},"2112":{"id":"/features/static-class-features-12","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"Static class features proposal, merged into class fields § this-proposal-has-been-merged-into-the-class-fields-proposal"},"2113":{"id":"/features/static-class-features-13","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2114":{"id":"/features/static-class-features-14","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMAScript 2022: Class Definitions grammar"},"2115":{"id":"/features/static-class-features-15","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2116":{"id":"/features/static-class-features-16","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMAScript 2022: ClassDefinitionEvaluation"},"2117":{"id":"/features/static-class-features-17","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2118":{"id":"/features/static-class-features-18","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMAScript 2022: Class Definitions early errors"},"2119":{"id":"/features/static-class-features-19","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2120":{"id":"/features/static-class-features-20","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMAScript 2022: PrivateGet"},"2121":{"id":"/features/static-class-features-21","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2122":{"id":"/features/static-class-features-22","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"TC39 notes: Class fields, Private methods, and Static class features for Stage 4"},"2123":{"id":"/features/static-class-features-23","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"Committee notes, published 2021-04-19, reviewed 2026-07-26"},"2124":{"id":"/features/static-class-features-24","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"Ecma International approves new standards at the 123rd General Assembly"},"2125":{"id":"/features/static-class-features-25","page_id":"/features/static-class-features","tags":[],"type":"text","url":"/features/static-class-features#sources","content":"Ecma General Assembly record, published 2022-06-22, reviewed 2026-07-26"},"2126":{"id":"/features/string-match-all","page_id":"/features/string-match-all","type":"page","content":"String.prototype.matchAll","breadcrumbs":["ecmascript","ES2020"],"tags":[],"url":"/features/string-match-all"},"2127":{"id":"/features/string-match-all-0","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#stringprototypematchall","content":"String.prototype.matchAll"},"2128":{"id":"/features/string-match-all-1","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#what-it-does","content":"What it does"},"2129":{"id":"/features/string-match-all-2","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#before--after","content":"Before / after"},"2130":{"id":"/features/string-match-all-3","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#gotchas","content":"Gotchas"},"2131":{"id":"/features/string-match-all-4","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#support","content":"Support"},"2132":{"id":"/features/string-match-all-5","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#related","content":"Related"},"2133":{"id":"/features/string-match-all-6","page_id":"/features/string-match-all","type":"heading","tags":[],"url":"/features/string-match-all#sources","content":"Primary sources"},"2134":{"id":"/features/string-match-all-7","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#stringprototypematchall","content":"`matchAll` returns an iterator of full match arrays and leaves the `lastIndex` of the regular expression it was given untouched."},"2135":{"id":"/features/string-match-all-8","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#what-it-does","content":"`matchAll` reads the `flags` property of its argument, throws a `TypeError` when the string form contains no `\"g\"`, and otherwise calls the argument's `@@matchAll` method; a non-regular-expression argument is wrapped by `RegExpCreate(regexp, \"g\")` first. `RegExp.prototype[@@matchAll]` builds a fresh matcher through `SpeciesConstructor`, copies the receiver's `lastIndex` onto it, and hands that copy to `CreateRegExpStringIterator`. Each `next` call runs `RegExpExec` on the copy, so iteration walks the copy's `lastIndex` and never writes to the original object. Every iteration result value is the same array `exec` produces, with its capture groups, `index`, and `input`. The stated reason for returning an iterator rather than an array is that gathering every match of a large string or of many capture groups has a cost the caller may not want, and a spread or `Array.from` recovers the array."},"2136":{"id":"/features/string-match-all-9","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#gotchas","content":"The copy inherits the receiver's position, so `pattern.lastIndex = 10` before the call skips everything before index 10 and the property still reads `10` afterwards. Two spreads of one result differ: the iterator sets its `[[Done]]` slot once `RegExpExec` returns `null` and then yields nothing further, so a second pass over the same iterator produces an empty array. A pattern that can match the empty string still terminates, because that clause advances `lastIndex` with `AdvanceStringIndex` after an empty match: `[...\"xx\".matchAll(/(?:)/g)]` yields matches at 0, 1, and 2. The rejection tests the observable `flags` string, so a `RegExp` subclass whose `flags` getter returns `\"y\"` is refused even when the instance was constructed with `\"g\"`."},"2137":{"id":"/features/string-match-all-10","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#support","content":"V8 shipped the method in 7.3, whose notes present it as an iterator over the matches of a global regular expression."},"2138":{"id":"/features/string-match-all-11","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#related","content":"string-replace-all"},"2139":{"id":"/features/string-match-all-12","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"String.prototype.matchAll proposal § iterator-versus-array"},"2140":{"id":"/features/string-match-all-13","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2141":{"id":"/features/string-match-all-14","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMAScript 2020: String.prototype.matchAll ( regexp )"},"2142":{"id":"/features/string-match-all-15","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMA-262 specification, published 2020-06-16, reviewed 2026-07-26"},"2143":{"id":"/features/string-match-all-16","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMAScript 2020: RegExp.prototype \\[ @@matchAll ] ( string )"},"2144":{"id":"/features/string-match-all-17","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMA-262 specification, published 2020-06-16, reviewed 2026-07-26"},"2145":{"id":"/features/string-match-all-18","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMAScript 2020: %RegExpStringIteratorPrototype%.next ( )"},"2146":{"id":"/features/string-match-all-19","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"ECMA-262 specification, published 2020-06-16, reviewed 2026-07-26"},"2147":{"id":"/features/string-match-all-20","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"TC39 notes: String.prototype.matchAll for Stage 4"},"2148":{"id":"/features/string-match-all-21","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"Committee notes, published 2019-03-26, reviewed 2026-07-26"},"2149":{"id":"/features/string-match-all-22","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"V8 release v7.3: String.prototype.matchAll"},"2150":{"id":"/features/string-match-all-23","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"Engine record, reviewed 2026-07-26"},"2151":{"id":"/features/string-match-all-24","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"Ecma International approves new standards at the 119th General Assembly"},"2152":{"id":"/features/string-match-all-25","page_id":"/features/string-match-all","tags":[],"type":"text","url":"/features/string-match-all#sources","content":"Ecma General Assembly record, published 2020-06-16, reviewed 2026-07-26"},"2153":{"id":"/features/string-pad-start-end","page_id":"/features/string-pad-start-end","type":"page","content":"String.prototype.padStart and padEnd","breadcrumbs":["ecmascript","ES2017"],"tags":[],"url":"/features/string-pad-start-end"},"2154":{"id":"/features/string-pad-start-end-0","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#stringprototypepadstart-and-padend","content":"String.prototype.padStart and padEnd"},"2155":{"id":"/features/string-pad-start-end-1","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#what-it-does","content":"What it does"},"2156":{"id":"/features/string-pad-start-end-2","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#before--after","content":"Before / after"},"2157":{"id":"/features/string-pad-start-end-3","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#gotchas","content":"Gotchas"},"2158":{"id":"/features/string-pad-start-end-4","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#support","content":"Support"},"2159":{"id":"/features/string-pad-start-end-5","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#related","content":"Related"},"2160":{"id":"/features/string-pad-start-end-6","page_id":"/features/string-pad-start-end","type":"heading","tags":[],"url":"/features/string-pad-start-end#sources","content":"Primary sources"},"2161":{"id":"/features/string-pad-start-end-7","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#stringprototypepadstart-and-padend","content":"Two string methods extend a string to a target length by repeating a fill string before or after it."},"2162":{"id":"/features/string-pad-start-end-8","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#what-it-does","content":"`padStart` coerces the receiver with `RequireObjectCoercible` and `ToString`, converts `maxLength` with `ToLength`, returns the string unchanged when that target is not greater than the current length, repeats `fillString` to exactly the missing length, and concatenates the filler before the string. `padEnd` performs the same steps and concatenates the filler after the string instead. The default `fillString` is a single U+0020 SPACE in both methods."},"2163":{"id":"/features/string-pad-start-end-9","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#what-it-does","content":"The proposal gives column formatting of monospaced text as the case that decided the argument's meaning: `maxLength` caps the result, and minimum-length behavior was left to `String.prototype.repeat`. Padding takes the first part of a multi-character fill string, following Ruby and PHP, so that `string.padStart(mask.length, mask)` lines a value up under its mask. The proposal cites repeated per-application padding helpers as the reason for a built-in. Its earlier `padLeft` and `padRight` names were replaced at the November 2015 meeting, which chose `padStart` and `padEnd` and moved `trimLeft` and `trimRight` to matching names."},"2164":{"id":"/features/string-pad-start-end-10","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#gotchas","content":"`maxLength` is a cap, not a minimum: a target no greater than the current length returns the string unchanged, so `\"abcdef\".padStart(3, \"0\")` is `\"abcdef\"` and a negative or `NaN` target leaves `\"7\"` alone. An empty `fillString` also short-circuits, so `\"ab\".padStart(5, \"\")` stays `\"ab\"` instead of being space-padded."},"2165":{"id":"/features/string-pad-start-end-11","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#gotchas","content":"Padding counts UTF-16 code units, because the length compared against `maxLength` is the number of elements in the string. A single astral character already occupies two of them, so `\"\\u{1F600}\".padStart(3, \"-\")` adds one dash and yields a string of length 3. The declared arity is `1` for both methods even though each accepts two arguments, since `fillString` is optional."},"2166":{"id":"/features/string-pad-start-end-12","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#support","content":"V8 announced the two methods as shipping in 5.6, then appended \"Unshipped again\" to that entry; the 5.7 release notes list `padStart` and `padEnd` among the standard-library additions included in that release, which is the version this page records."},"2167":{"id":"/features/string-pad-start-end-13","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#related","content":"string-trim-start-end"},"2168":{"id":"/features/string-pad-start-end-14","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"String.prototype.padStart/padEnd: Rationale"},"2169":{"id":"/features/string-pad-start-end-15","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2170":{"id":"/features/string-pad-start-end-16","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"String.prototype.padStart/padEnd: Semantics of \"min length\" vs \"max length\""},"2171":{"id":"/features/string-pad-start-end-17","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2172":{"id":"/features/string-pad-start-end-18","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"String.prototype.padStart/padEnd: Left padding, with respect to the fill string"},"2173":{"id":"/features/string-pad-start-end-19","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2174":{"id":"/features/string-pad-start-end-20","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"String.prototype.padStart/padEnd: Naming"},"2175":{"id":"/features/string-pad-start-end-21","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2176":{"id":"/features/string-pad-start-end-22","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"ECMAScript 2017: String.prototype.padStart( maxLength \\[ , fillString ] )"},"2177":{"id":"/features/string-pad-start-end-23","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"ECMA-262 specification, published 2017-06-27, reviewed 2026-07-26"},"2178":{"id":"/features/string-pad-start-end-24","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"ECMAScript 2017: String.prototype.padEnd( maxLength \\[ , fillString ] )"},"2179":{"id":"/features/string-pad-start-end-25","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"ECMA-262 specification, published 2017-06-27, reviewed 2026-07-26"},"2180":{"id":"/features/string-pad-start-end-26","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"TC39 notes: String.prototype.pad\\{Start,End}"},"2181":{"id":"/features/string-pad-start-end-27","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"Committee notes, published 2016-05-25, reviewed 2026-07-26"},"2182":{"id":"/features/string-pad-start-end-28","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"V8 release v5.7: JavaScript language features"},"2183":{"id":"/features/string-pad-start-end-29","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"Engine record, published 2017-02-06, reviewed 2026-07-26"},"2184":{"id":"/features/string-pad-start-end-30","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"V8 release v5.6: String.prototype.padStart / String.prototype.padEnd"},"2185":{"id":"/features/string-pad-start-end-31","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"Engine record, published 2016-12-02, reviewed 2026-07-26"},"2186":{"id":"/features/string-pad-start-end-32","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"Last results of the 113th Ecma General Assembly held in Montreux, June 27, 2017"},"2187":{"id":"/features/string-pad-start-end-33","page_id":"/features/string-pad-start-end","tags":[],"type":"text","url":"/features/string-pad-start-end#sources","content":"Ecma General Assembly record, published 2017-06-27, reviewed 2026-07-26"},"2188":{"id":"/features/string-replace-all","page_id":"/features/string-replace-all","type":"page","content":"String.prototype.replaceAll","breadcrumbs":["ecmascript","ES2021"],"tags":[],"url":"/features/string-replace-all"},"2189":{"id":"/features/string-replace-all-0","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#stringprototypereplaceall","content":"String.prototype.replaceAll"},"2190":{"id":"/features/string-replace-all-1","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#what-it-does","content":"What it does"},"2191":{"id":"/features/string-replace-all-2","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#before--after","content":"Before / after"},"2192":{"id":"/features/string-replace-all-3","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#gotchas","content":"Gotchas"},"2193":{"id":"/features/string-replace-all-4","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#support","content":"Support"},"2194":{"id":"/features/string-replace-all-5","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#related","content":"Related"},"2195":{"id":"/features/string-replace-all-6","page_id":"/features/string-replace-all","type":"heading","tags":[],"url":"/features/string-replace-all#sources","content":"Primary sources"},"2196":{"id":"/features/string-replace-all-7","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#stringprototypereplaceall","content":"`replaceAll` substitutes every occurrence of a string search value and rejects a regular expression that has no global flag."},"2197":{"id":"/features/string-replace-all-8","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#what-it-does","content":"`replaceAll` collects every match position with `StringIndexOf` before building the result, advancing by `max(1, searchLength)` after each hit. `replace` locates a single position and returns after one substitution. Both route a `searchValue` that carries `@@replace` to that method, but `replaceAll` first reads `flags` and throws a `TypeError` when the string form of `flags` contains no `\"g\"`. The proposal ties that rejection to the method name: a missing global flag asks for one replacement while the name asks for all of them. A string replacement still passes through `GetSubstitution`, so `$&`, `` $` ``, `$'`, and `$$` keep their meaning in each individual replacement, and a function replacement is called once per match with the matched text, its position, and the whole string."},"2198":{"id":"/features/string-replace-all-9","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#gotchas","content":"An empty search value matches between every UTF-16 code unit and at both ends, which the proposal records as following the precedent of `replace`: `\"xxx\".replaceAll(\"\", \"-\")` yields `-x-x-x-`. Matches never overlap, because the scan advances by the search length, so `\"aaaa\".replaceAll(\"aa\", \"b\")` gives `bb` rather than three matches. A `$` in a string replacement is still interpreted, so replacing with `\"$&\"` reinserts the match and a literal dollar sign needs `\"$$\"`. The global-flag check reads the `flags` property rather than the regular expression's internal state, so a subclass that reports a `flags` string without `\"g\"` is rejected even when its behavior is global."},"2199":{"id":"/features/string-replace-all-10","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#support","content":"V8 shipped the method in 8.5, whose notes present it as replacing every occurrence without constructing a global regular expression."},"2200":{"id":"/features/string-replace-all-11","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#related","content":"string-match-all"},"2201":{"id":"/features/string-replace-all-12","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"String.prototype.replaceAll proposal § high-level-api"},"2202":{"id":"/features/string-replace-all-13","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2203":{"id":"/features/string-replace-all-14","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"String.prototype.replaceAll proposal § what-happens-if-searchvalue-is-the-empty-string"},"2204":{"id":"/features/string-replace-all-15","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2205":{"id":"/features/string-replace-all-16","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMAScript 2021: String.prototype.replaceAll ( searchValue, replaceValue )"},"2206":{"id":"/features/string-replace-all-17","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"2207":{"id":"/features/string-replace-all-18","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMAScript 2021: String.prototype.replace ( searchValue, replaceValue )"},"2208":{"id":"/features/string-replace-all-19","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"2209":{"id":"/features/string-replace-all-20","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMAScript 2021: GetSubstitution"},"2210":{"id":"/features/string-replace-all-21","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"2211":{"id":"/features/string-replace-all-22","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"TC39 notes: String.prototype.replaceAll for Stage 4"},"2212":{"id":"/features/string-replace-all-23","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"Committee notes, published 2020-06-02, reviewed 2026-07-26"},"2213":{"id":"/features/string-replace-all-24","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"V8 release v8.5: String.prototype.replaceAll"},"2214":{"id":"/features/string-replace-all-25","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"Engine record, reviewed 2026-07-26"},"2215":{"id":"/features/string-replace-all-26","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"Ecma International approves new standards at the 121st General Assembly"},"2216":{"id":"/features/string-replace-all-27","page_id":"/features/string-replace-all","tags":[],"type":"text","url":"/features/string-replace-all#sources","content":"Ecma General Assembly record, published 2021-06-22, reviewed 2026-07-26"},"2217":{"id":"/features/string-trim-start-end","page_id":"/features/string-trim-start-end","type":"page","content":"String.prototype.trimStart and trimEnd","breadcrumbs":["ecmascript","ES2019"],"tags":[],"url":"/features/string-trim-start-end"},"2218":{"id":"/features/string-trim-start-end-0","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#stringprototypetrimstart-and-trimend","content":"String.prototype.trimStart and trimEnd"},"2219":{"id":"/features/string-trim-start-end-1","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#what-it-does","content":"What it does"},"2220":{"id":"/features/string-trim-start-end-2","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#before--after","content":"Before / after"},"2221":{"id":"/features/string-trim-start-end-3","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#gotchas","content":"Gotchas"},"2222":{"id":"/features/string-trim-start-end-4","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#support","content":"Support"},"2223":{"id":"/features/string-trim-start-end-5","page_id":"/features/string-trim-start-end","type":"heading","tags":[],"url":"/features/string-trim-start-end#sources","content":"Primary sources"},"2224":{"id":"/features/string-trim-start-end-6","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#stringprototypetrimstart-and-trimend","content":"Two standard methods remove white space from one end of a string, with `trimLeft` and `trimRight` kept as aliases in Annex B."},"2225":{"id":"/features/string-trim-start-end-7","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#what-it-does","content":"`String.prototype.trimStart` calls `TrimString(S, \"start\")` and `String.prototype.trimEnd` calls `TrimString(S, \"end\")`. `TrimString` applies `RequireObjectCoercible` and `ToString` to the receiver, then removes leading, trailing, or both runs according to `where`, and defines the removed set as the union of `WhiteSpace` and `LineTerminator`. Annex B keeps `trimLeft` and `trimRight` as properties whose initial values are the same function objects as `trimStart` and `trimEnd`, and recommends the new names in new code. The proposal gives the naming reason: symmetry with `padStart` and `padEnd`, with the older names retained for web compatibility."},"2226":{"id":"/features/string-trim-start-end-8","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#gotchas","content":"The removed set includes line terminators, so `\"\\u2028x\".trimStart()` drops the leading paragraph-class separator rather than stopping at the first non-space character. It also includes every code point in Unicode general category Space\\_Separator, so the leading U+00A0 above disappears from `trimStart` while `trimEnd` keeps it. The aliases are the same function objects, so `String.prototype.trimRight === String.prototype.trimEnd` holds and the proposal records the visible consequence: `String.prototype.trimRight.name` reads `\"trimEnd\"`, which breaks code that identifies a method by its `name`."},"2227":{"id":"/features/string-trim-start-end-9","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#support","content":"V8 implemented both methods in 6.6, whose note records that the pre-existing `trimLeft` and `trimRight` remain as aliases."},"2228":{"id":"/features/string-trim-start-end-10","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMAScript proposal: String.prototype.trimStart / String.prototype.trimEnd § naming--aliasing"},"2229":{"id":"/features/string-trim-start-end-11","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2230":{"id":"/features/string-trim-start-end-12","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMAScript 2019: String.prototype.trimStart ( )"},"2231":{"id":"/features/string-trim-start-end-13","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2232":{"id":"/features/string-trim-start-end-14","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMAScript 2019: String.prototype.trimEnd ( )"},"2233":{"id":"/features/string-trim-start-end-15","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2234":{"id":"/features/string-trim-start-end-16","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMAScript 2019: Runtime Semantics: TrimString ( string, where )"},"2235":{"id":"/features/string-trim-start-end-17","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2236":{"id":"/features/string-trim-start-end-18","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMAScript 2019: String.prototype.trimLeft ( )"},"2237":{"id":"/features/string-trim-start-end-19","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2238":{"id":"/features/string-trim-start-end-20","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"TC39 notes: String.prototype.\\{trimStart,trimEnd} for Stage 4"},"2239":{"id":"/features/string-trim-start-end-21","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"Committee notes, published 2019-01-29, reviewed 2026-07-26"},"2240":{"id":"/features/string-trim-start-end-22","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"V8 release v6.6: One-sided string trimming"},"2241":{"id":"/features/string-trim-start-end-23","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"Engine record, published 2018-03-27, reviewed 2026-07-26"},"2242":{"id":"/features/string-trim-start-end-24","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"Ecma International approves new standards at the 117th General Assembly"},"2243":{"id":"/features/string-trim-start-end-25","page_id":"/features/string-trim-start-end","tags":[],"type":"text","url":"/features/string-trim-start-end#sources","content":"Ecma General Assembly record, published 2019-06-26, reviewed 2026-07-26"},"2244":{"id":"/features/symbol-description","page_id":"/features/symbol-description","type":"page","content":"Symbol.prototype.description","breadcrumbs":["ecmascript","ES2019"],"tags":[],"url":"/features/symbol-description"},"2245":{"id":"/features/symbol-description-0","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#symbolprototypedescription","content":"Symbol.prototype.description"},"2246":{"id":"/features/symbol-description-1","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#what-it-does","content":"What it does"},"2247":{"id":"/features/symbol-description-2","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#before--after","content":"Before / after"},"2248":{"id":"/features/symbol-description-3","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#gotchas","content":"Gotchas"},"2249":{"id":"/features/symbol-description-4","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#support","content":"Support"},"2250":{"id":"/features/symbol-description-5","page_id":"/features/symbol-description","type":"heading","tags":[],"url":"/features/symbol-description#sources","content":"Primary sources"},"2251":{"id":"/features/symbol-description-6","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#symbolprototypedescription","content":"A getter on `Symbol.prototype` returns a symbol's `[[Description]]` value unchanged, including `undefined`."},"2252":{"id":"/features/symbol-description-7","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#what-it-does","content":"`Symbol.prototype.description` is an accessor property whose set accessor is `undefined`; its get accessor coerces the receiver with `thisSymbolValue` and returns that symbol's `[[Description]]`. `Symbol ( [ description ] )` leaves the slot `undefined` when the argument is absent and otherwise stores `ToString(description)`, so the slot distinguishes a missing argument from an empty string. `SymbolDescriptiveString`, which `Symbol.prototype.toString` calls, substitutes the empty string for an `undefined` description before wrapping it in `Symbol(` and `)`, so that route erases the distinction."},"2253":{"id":"/features/symbol-description-8","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#gotchas","content":"`Symbol(\"\")` and `Symbol()` produce the same `toString()` text, `\"Symbol()\"`, so string slicing reports an empty description for both; only the getter separates `\"\"` from `undefined`. There is no setter, so `symbol.description = \"x\"` is discarded in sloppy code and throws a `TypeError` under strict mode, because the property's set accessor function is `undefined`. The getter reaches the same slot for every symbol, so a well-known symbol reports its specification name, `Symbol.iterator.description` being `\"Symbol.iterator\"`, and a symbol from `Symbol.for` reports its registry key rather than any wrapper text."},"2254":{"id":"/features/symbol-description-9","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#support","content":"V8 exposed the accessor in 7.0, whose announcement contrasts it with reaching a description indirectly through `Symbol.prototype.toString()`."},"2255":{"id":"/features/symbol-description-10","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMAScript proposal: Symbol.prototype.description"},"2256":{"id":"/features/symbol-description-11","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2257":{"id":"/features/symbol-description-12","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMAScript 2019: get Symbol.prototype.description"},"2258":{"id":"/features/symbol-description-13","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2259":{"id":"/features/symbol-description-14","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMAScript 2019: Symbol ( \\[ description ] )"},"2260":{"id":"/features/symbol-description-15","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2261":{"id":"/features/symbol-description-16","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMAScript 2019: Runtime Semantics: SymbolDescriptiveString ( sym )"},"2262":{"id":"/features/symbol-description-17","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"ECMA-262 specification, published 2019-06-26, reviewed 2026-07-26"},"2263":{"id":"/features/symbol-description-18","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"TC39 notes: Symbol.description for Stage 4"},"2264":{"id":"/features/symbol-description-19","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"Committee notes, published 2018-11-27, reviewed 2026-07-26"},"2265":{"id":"/features/symbol-description-20","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"V8 release v7.0: JavaScript language features"},"2266":{"id":"/features/symbol-description-21","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"Engine record, published 2018-10-15, reviewed 2026-07-26"},"2267":{"id":"/features/symbol-description-22","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"Ecma International approves new standards at the 117th General Assembly"},"2268":{"id":"/features/symbol-description-23","page_id":"/features/symbol-description","tags":[],"type":"text","url":"/features/symbol-description#sources","content":"Ecma General Assembly record, published 2019-06-26, reviewed 2026-07-26"},"2269":{"id":"/features/symbols-as-weakmap-keys","page_id":"/features/symbols-as-weakmap-keys","type":"page","content":"Symbols as WeakMap keys","breadcrumbs":["ecmascript","ES2023"],"tags":[],"url":"/features/symbols-as-weakmap-keys"},"2270":{"id":"/features/symbols-as-weakmap-keys-0","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#symbols-as-weakmap-keys","content":"Symbols as WeakMap keys"},"2271":{"id":"/features/symbols-as-weakmap-keys-1","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#what-it-does","content":"What it does"},"2272":{"id":"/features/symbols-as-weakmap-keys-2","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#before--after","content":"Before / after"},"2273":{"id":"/features/symbols-as-weakmap-keys-3","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#gotchas","content":"Gotchas"},"2274":{"id":"/features/symbols-as-weakmap-keys-4","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#related","content":"Related"},"2275":{"id":"/features/symbols-as-weakmap-keys-5","page_id":"/features/symbols-as-weakmap-keys","type":"heading","tags":[],"url":"/features/symbols-as-weakmap-keys#sources","content":"Primary sources"},"2276":{"id":"/features/symbols-as-weakmap-keys-6","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#symbols-as-weakmap-keys","content":"Unique symbols are accepted wherever a weak collection previously demanded an object, so a key needs no object to stand in for it."},"2277":{"id":"/features/symbols-as-weakmap-keys-7","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#what-it-does","content":"`CanBeHeldWeakly` decides which values a weak collection accepts: every object, plus every symbol whose `KeyForSymbol` result is undefined. That single operation covers `WeakMap` keys, `WeakSet` elements, a `WeakRef` target, and both the target and the unregister token of a `FinalizationRegistry`, and `WeakMap.prototype.set` throws a `TypeError` when `CanBeHeldWeakly(key)` is false. The proposal frames the change as removing a restriction that forced object identity onto keys."},"2278":{"id":"/features/symbols-as-weakmap-keys-8","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#gotchas","content":"A symbol from `Symbol.for` keeps failing the check, because `KeyForSymbol` returns its registry key, so `new WeakMap().set(Symbol.for(\"palette\"), {})` still throws a `TypeError`. Well-known symbols such as `Symbol.iterator` are accepted even though they are never collected. The specification note explains both outcomes through language identity."},"2279":{"id":"/features/symbols-as-weakmap-keys-9","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#related","content":"weakref"},"2280":{"id":"/features/symbols-as-weakmap-keys-10","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#related","content":"finalization-registry"},"2281":{"id":"/features/symbols-as-weakmap-keys-11","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"Symbols as WeakMap keys proposal § introduction"},"2282":{"id":"/features/symbols-as-weakmap-keys-12","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2283":{"id":"/features/symbols-as-weakmap-keys-13","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"Symbols as WeakMap keys proposal § well-known-and-registered-symbols-as-weakmap-keys"},"2284":{"id":"/features/symbols-as-weakmap-keys-14","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2285":{"id":"/features/symbols-as-weakmap-keys-15","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"ECMAScript 2023: CanBeHeldWeakly"},"2286":{"id":"/features/symbols-as-weakmap-keys-16","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"ECMA-262 specification, published 2023-06-27, reviewed 2026-07-26"},"2287":{"id":"/features/symbols-as-weakmap-keys-17","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"ECMAScript 2023: WeakMap.prototype.set"},"2288":{"id":"/features/symbols-as-weakmap-keys-18","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"ECMA-262 specification, published 2023-06-27, reviewed 2026-07-26"},"2289":{"id":"/features/symbols-as-weakmap-keys-19","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"TC39 notes: Symbols as WeakMap keys for Stage 4"},"2290":{"id":"/features/symbols-as-weakmap-keys-20","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"Committee notes, published 2023-01-30, reviewed 2026-07-26"},"2291":{"id":"/features/symbols-as-weakmap-keys-21","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"Ecma International approves new standards at the 125th General Assembly"},"2292":{"id":"/features/symbols-as-weakmap-keys-22","page_id":"/features/symbols-as-weakmap-keys","tags":[],"type":"text","url":"/features/symbols-as-weakmap-keys#sources","content":"Ecma General Assembly record, published 2023-06-27, reviewed 2026-07-26"},"2293":{"id":"/features/template-literal-revision","page_id":"/features/template-literal-revision","type":"page","content":"Template literal revision","breadcrumbs":["ecmascript","ES2018"],"tags":[],"url":"/features/template-literal-revision"},"2294":{"id":"/features/template-literal-revision-0","page_id":"/features/template-literal-revision","type":"heading","tags":[],"url":"/features/template-literal-revision#template-literal-revision","content":"Template literal revision"},"2295":{"id":"/features/template-literal-revision-1","page_id":"/features/template-literal-revision","type":"heading","tags":[],"url":"/features/template-literal-revision#what-it-does","content":"What it does"},"2296":{"id":"/features/template-literal-revision-2","page_id":"/features/template-literal-revision","type":"heading","tags":[],"url":"/features/template-literal-revision#before--after","content":"Before / after"},"2297":{"id":"/features/template-literal-revision-3","page_id":"/features/template-literal-revision","type":"heading","tags":[],"url":"/features/template-literal-revision#gotchas","content":"Gotchas"},"2298":{"id":"/features/template-literal-revision-4","page_id":"/features/template-literal-revision","type":"heading","tags":[],"url":"/features/template-literal-revision#sources","content":"Primary sources"},"2299":{"id":"/features/template-literal-revision-5","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#template-literal-revision","content":"A tagged template may contain a malformed escape sequence; its cooked string becomes `undefined` while the raw string keeps the source text."},"2300":{"id":"/features/template-literal-revision-6","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#what-it-does","content":"The lexical grammar gains `TemplateCharacter :: \\ NotEscapeSequence`, covering a backslash followed by text that is not a legal escape sequence. The early error for that production is now conditional: it is a Syntax Error only when the `[Tagged]` parameter was not set, so an untagged template still rejects the sequence while a tagged one parses. The Template Value of `\\ NotEscapeSequence` is undefined, and an undefined component makes the whole component's Template Value undefined, while the Template Raw Value keeps the escape interpreted literally. `GetTemplateObject` builds the cooked array from the Template Values and the `raw` array from the Template Raw Values, so the tag receives `undefined` in one and the source text in the other."},"2301":{"id":"/features/template-literal-revision-7","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#what-it-does","content":"The V8 release notes give the use the relaxation enables: a tag that consumes another language's escape conventions, illustrated with a LaTeX processor whose input contains `\\newcommand` and `\\u{h}ere`."},"2302":{"id":"/features/template-literal-revision-8","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#gotchas","content":"Only tagged templates changed. Evaluating the same literal without a tag still throws a `SyntaxError`, because the early error applies whenever the `[Tagged]` parameter was not set. A tag that reads the cooked array must therefore handle `undefined` per element: one malformed escape makes only its own component undefined, so `strings` can mix strings and `undefined` in a template with substitutions."},"2303":{"id":"/features/template-literal-revision-9","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#gotchas","content":"The raw array is unaffected either way, which is why a tag written against `strings.raw` needs no change. Each `raw` element keeps escape sequences uninterpreted, so `\\unicode` arrives as the eight characters of source text rather than as a decoded code point."},"2304":{"id":"/features/template-literal-revision-10","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#sources","content":"Template Literals Revision"},"2305":{"id":"/features/template-literal-revision-11","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2306":{"id":"/features/template-literal-revision-12","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#sources","content":"ECMAScript 2018: Static Semantics: Early Errors for template literals"},"2307":{"id":"/features/template-literal-revision-13","page_id":"/features/template-literal-revision","tags":[],"type":"text","url":"/features/template-literal-revision#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"2308":{"id":"/features/template-literal-revision-14","page_id":"/features/template-literal-revision","tags":[],"type":"tex