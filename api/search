-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"Announcing TypeScript 5.6"},"3421":{"id":"/features/ts-no-check-11","page_id":"/features/ts-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"TypeScript release announcement, published 2024-09-09, reviewed 2026-07-24"},"3422":{"id":"/features/ts-no-check-12","page_id":"/features/ts-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"TypeScript 5.6 release notes: noCheck"},"3423":{"id":"/features/ts-no-check-13","page_id":"/features/ts-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"TypeScript release notes, reviewed 2026-07-24"},"3424":{"id":"/features/ts-no-check-14","page_id":"/features/ts-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"TypeScript 5.6 stable release"},"3425":{"id":"/features/ts-no-check-15","page_id":"/features/ts-no-check","tags":[],"type":"text","url":"/features/ts-no-check#sources","content":"Release tag, published 2024-09-09, reviewed 2026-07-24"},"3426":{"id":"/features/ts-no-default-lib-directive","page_id":"/features/ts-no-default-lib-directive","type":"page","content":"no-default-lib directive removal","breadcrumbs":["typescript","TS 6.0"],"tags":[],"url":"/features/ts-no-default-lib-directive"},"3427":{"id":"/features/ts-no-default-lib-directive-0","page_id":"/features/ts-no-default-lib-directive","type":"heading","tags":[],"url":"/features/ts-no-default-lib-directive#no-default-lib-directive-removal","content":"no-default-lib directive removal"},"3428":{"id":"/features/ts-no-default-lib-directive-1","page_id":"/features/ts-no-default-lib-directive","type":"heading","tags":[],"url":"/features/ts-no-default-lib-directive#what-it-does","content":"What it does"},"3429":{"id":"/features/ts-no-default-lib-directive-2","page_id":"/features/ts-no-default-lib-directive","type":"heading","tags":[],"url":"/features/ts-no-default-lib-directive#migration","content":"Migration"},"3430":{"id":"/features/ts-no-default-lib-directive-3","page_id":"/features/ts-no-default-lib-directive","type":"heading","tags":[],"url":"/features/ts-no-default-lib-directive#compatibility","content":"Compatibility"},"3431":{"id":"/features/ts-no-default-lib-directive-4","page_id":"/features/ts-no-default-lib-directive","type":"heading","tags":[],"url":"/features/ts-no-default-lib-directive#sources","content":"Primary sources"},"3432":{"id":"/features/ts-no-default-lib-directive-5","page_id":"/features/ts-no-default-lib-directive","tags":[],"type":"text","url":"/features/ts-no-default-lib-directive#no-default-lib-directive-removal","content":"The `no-default-lib` triple-slash reference is parsed but ignored."},"3433":{"id":"/features/ts-no-default-lib-directive-6","page_id":"/features/ts-no-default-lib-directive","tags":[],"type":"text","url":"/features/ts-no-default-lib-directive#what-it-does","content":"`/// <reference no-default-lib=\"true\"/>` no longer excludes default libraries from the program. The supported controls are the `noLib` compiler option and explicit library replacement."},"3434":{"id":"/features/ts-no-default-lib-directive-7","page_id":"/features/ts-no-default-lib-directive","tags":[],"type":"text","url":"/features/ts-no-default-lib-directive#migration","content":"Remove the directive and configure `noLib` or `libReplacement` at project level according to whether the project omits or substitutes default declarations."},"3435":{"id":"/features/ts-no-default-lib-directive-8","page_id":"/features/ts-no-default-lib-directive","tags":[],"type":"text","url":"/features/ts-no-default-lib-directive#compatibility","content":"Files that relied on the directive can acquire default global declarations because the parser no longer sets the corresponding source-file state. The stable parser ignores the directive instead of populating the library-control field."},"3436":{"id":"/features/ts-no-default-lib-directive-9","