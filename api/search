res/temporal-runtime-support-22","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#related","content":"temporal"},"2344":{"id":"/features/temporal-runtime-support-23","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"Firefox 139 release notes for developers § javascript"},"2345":{"id":"/features/temporal-runtime-support-24","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"Engine record, published 2025-05-27, reviewed 2026-07-24"},"2346":{"id":"/features/temporal-runtime-support-25","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"MDN browser compatibility data: Temporal"},"2347":{"id":"/features/temporal-runtime-support-26","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"Compatibility data, reviewed 2026-07-24"},"2348":{"id":"/features/temporal-runtime-support-27","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"Node.js 26.0.0 release § temporal-api"},"2349":{"id":"/features/temporal-runtime-support-28","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#sources","content":"Runtime release announcement, published 2026-05-05, reviewed 2026-07-24"},"2350":{"id":"/features/temporal","page_id":"/features/temporal","type":"page","content":"Temporal","breadcrumbs":["ecmascript","Edition unresolved"],"tags":[],"url":"/features/temporal"},"2351":{"id":"/features/temporal-0","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#temporal","content":"Temporal"},"2352":{"id":"/features/temporal-1","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#what-it-does","content":"What it does"},"2353":{"id":"/features/temporal-2","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#before--after","content":"Before / after"},"2354":{"id":"/features/temporal-3","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#gotchas","content":"Gotchas"},"2355":{"id":"/features/temporal-4","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#related","content":"Related"},"2356":{"id":"/features/temporal-5","page_id":"/features/temporal","type":"heading","tags":[],"url":"/features/temporal#sources","content":"Primary sources"},"2357":{"id":"/features/temporal-6","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#temporal","content":"Temporal supplies immutable objects for exact time, civil dates and times, time zones, calendars, and durations."},"2358":{"id":"/features/temporal-7","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#what-it-does","content":"`Temporal.Instant` represents a point on the time line. `Temporal.ZonedDateTime` combines an instant with a time zone and calendar, while the `Plain` types represent civil values without a time zone. `Temporal.Duration` represents a length of time for arithmetic and comparison with the required context."},"2359":{"id":"/features/temporal-8","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#gotchas","content":"Temporal objects are immutable and do not replace or subclass `Date`. Calendar-day arithmetic and exact elapsed-time arithmetic are distinct operations, especially across time-zone offset transitions."},"2360":{"id":"/features/temporal-9","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#related","content":"temporal-runtime-support"},"2361":{"id":"/features/temporal-10","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"Temporal proposal § documentation"},"2362":{"id":"/features/temporal-11","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"2363":{"id":"/features/temporal-12","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"Temporal proposal § principles"},"2364":{"id":"/features/temporal-13","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"2365":{"id":"/features/temporal-14","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 notes: Temporal for Stage 4"},"2366":{"id":"/features/temporal-15","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"Committee notes, published 2026-03-11, reviewed 2026-07-23"},"2367":{"id":"/features/temporal-16","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"Finished proposals when Temporal entered Stage 4"},"2368":{"id":"/features/temporal-17","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 stage record, published 2026-03-11, reviewed 2026-07-23"},"2369":{"id":"/features/temporal-18","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 finished proposals at the cutoff"},"2370":{"id":"/features/temporal-19","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 stage record, published 2026-07-22, reviewed 2026-07-23"},"2371":{"id":"/features/temporal-20","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"Temporal proposal specification"},"2372":{"id":"/features/temporal-21","page_id":"/features/temporal","tags":[],"type":"text","url":"/features/temporal#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"2373":{"id":"/features/top-level-await","page_id":"/features/top-level-await","type":"page","content":"Top-level await","breadcrumbs":["ecmascript","ES2022"],"tags":[],"url":"/features/top-level-await"},"2374":{"id":"/features/top-level-await-0","page_id":"/features/top-level-await","type":"heading","tags":[],"url":"/features/top-level-await#top-level-await","content":"Top-level await"},"2375":{"id":"/features/top-level-await-1","page_id":"/features/top-level-await","type":"heading","tags":[],"url":"/features/top-level-await#what-it-does","content":"What it does"},"2376":{"id":"/features/top-level-await-2","page_id":"/features/top-level-await","type":"heading","tags":[],"url":"/features/top-level-await#before--after","content":"Before / after"},"2377":{"id":"/features/top-level-await-3","page_id":"/features/top-level-await","type":"heading","tags":[],"url":"/features/top-level-await#gotchas","content":"Gotchas"},"2378":{"id":"/features/top-level-await-4","page_id":"/features/top-level-await","type":"heading","tags":[],"url":"/features/top-level-await#sources","content":"Primary sources"},"2379":{"id":"/features/top-level-await-5","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#top-level-await","content":"A module body may contain `await`, and importers wait for that module to settle before their own body runs."},"2380":{"id":"/features/top-level-await-6","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#what-it-does","content":"A `ModuleItem` parses its `StatementListItem` with the `Await` parameter set, so an `await` expression is legal directly in a module body. Module evaluation marks such a record with `[[HasTLA]]`, sets `[[AsyncEvaluation]]`, and counts each asynchronous dependency in `[[PendingAsyncDependencies]]` so that a module with pending dependencies is not executed yet. Executing one of these modules creates a promise capability and resumes the graph from its fulfilment or rejection handler. `[[Status]]` gains the value `evaluating-async` for a module that has executed and is awaiting top-level completion. The proposal's own framing is that a module behaves like one large async function whose importers wait before evaluating their bodies."},"2381":{"id":"/features/top-level-await-7","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#gotchas","content":"Waiting follows the import graph, not source adjacency. The proposal spells out that importing one module before another creates no dependency between them, so a module that imports an awaiting `x.mjs` and then a plain `y.mjs` prints `X1`, `Y`, `X2`: `y.mjs` runs while `x.mjs` is suspended. The effect also propagates upward without any `await` being written: a module with a pending asynchronous dependency has `[[AsyncEvaluation]]` set as well, so adding one `await` deep in a graph turns every ancestor's evaluation asynchronous, and a polyfill that starts to await must be imported by each module that relies on it to take effect reliably. Graphs without any `await` keep their previous timing, because the specification only routes a module through promise machinery when `[[HasTLA]]` or a pending dependency applies."},"2382":{"id":"/features/top-level-await-8","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript proposal: Top-level await § synopsis"},"2383":{"id":"/features/top-level-await-9","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2384":{"id":"/features/top-level-await-10","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript proposal: Top-level await § why-doesnt-top-level-await-block-the-import-of-an-adjacent-module"},"2385":{"id":"/features/top-level-await-11","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2386":{"id":"/features/top-level-await-12","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript proposal: Top-level await § do-these-guarantees-meet-the-needs-of-polyfills"},"2387":{"id":"/features/top-level-await-13","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2388":{"id":"/features/top-level-await-14","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript 2022: Modules grammar"},"2389":{"id":"/features/top-level-await-15","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2390":{"id":"/features/top-level-await-16","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript 2022: InnerModuleEvaluation"},"2391":{"id":"/features/top-level-await-17","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2392":{"id":"/features/top-level-await-18","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript 2022: ExecuteAsyncModule"},"2393":{"id":"/features/top-level-await-19","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2394":{"id":"/features/top-level-await-20","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMAScript 2022: Cyclic Module Records"},"2395":{"id":"/features/top-level-await-21","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"2396":{"id":"/features/top-level-await-22","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"TC39 notes: Top Level Await for Stage 4"},"2397":{"id":"/features/top-level-await-23","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"Committee notes, published 2021-05-25, reviewed 2026-07-26"},"2398":{"id":"/features/top-level-await-24","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"Ecma International approves new standards at the 123rd General Assembly"},"2399":{"id":"/features/top-level-await-25","page_id":"/features/top-level-await","tags":[],"type":"text","url":"/features/top-level-await#sources","content":"Ecma General Assembly record, published 2022-06-22, reviewed 2026-07-26"},"2400":{"id":"/features/trailing-function-commas","page_id":"/features/trailing-function-commas","type":"page","content":"Trailing commas in function parameter lists and calls","breadcrumbs":["ecmascript","ES2017"],"tags":[],"url":"/features/trailing-function-commas"},"2401":{"id":"/features/trailing-function-commas-0","page_id":"/features/trailing-function-commas","type":"heading","tags":[],"url":"/features/trailing-function-commas#trailing-commas-in-function-parameter-lists-and-calls","content":"Trailing commas in function parameter lists and calls"},"2402":{"id":"/features/trailing-function-commas-1","page_id":"/features/trailing-function-commas","type":"heading","tags":[],"url":"/features/trailing-function-commas#what-it-does","content":"What it does"},"2403":{"id":"/features/trailing-function-commas-2","page_id":"/features/trailing-function-commas","type":"heading","tags":[],"url":"/features/trailing-function-commas#before--after","content":"Before / after"},"2404":{"id":"/features/trailing-function-commas-3","page_id":"/features/trailing-function-commas","type":"heading","tags":[],"url":"/features/trailing-function-commas#gotchas","content":"Gotchas"},"2405":{"id":"/features/trailing-function-commas-4","page_id":"/features/trailing-function-commas","type":"heading","tags":[],"url":"/features/trailing-function-commas#sources","content":"Primary sources"},"2406":{"id":"/features/trailing-function-commas-5","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#trailing-commas-in-function-parameter-lists-and-calls","content":"A single trailing comma is accepted after the last entry of a parameter list and after the last call argument."},"2407":{"id":"/features/trailing-function-commas-6","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#what-it-does","content":"The `FormalParameters` production gains an alternative that ends a `FormalParameterList` with a comma, and `Arguments` gains the form `( ArgumentList , )`. Both are grammar-only changes, so the same code parses in every place those productions are used: function declarations and expressions, arrow functions, methods, generators, class constructors, `new` expressions, and ordinary calls."},"2408":{"id":"/features/trailing-function-commas-7","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#what-it-does","content":"The proposal's motivation is version-control attribution: with a trailing comma already present, appending a parameter or an argument on its own line stops rewriting the previous line and stops reassigning that line's blame to the person who added the comma. It also states that the change touches no semantics, so a trailing comma leaves a function's `length` alone."},"2409":{"id":"/features/trailing-function-commas-8","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#gotchas","content":"A rest parameter still has to be last with nothing after it, so `function f(...items,) {}` is a `SyntaxError`: the trailing-comma alternative applies to `FormalParameterList`, while a `FunctionRestParameter` appears only in the alternatives that end without a comma."},"2410":{"id":"/features/trailing-function-commas-9","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#gotchas","content":"Exactly one comma is permitted, and it needs an argument before it. `ArgumentList` has no production for an elided element, so `f(,)` and `f(1,,)` are both `SyntaxError`s, while the same doubled comma inside an array literal is legal and leaves a hole: `[1,,2]` has length 3 and no element at index 1."},"2411":{"id":"/features/trailing-function-commas-10","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"Proposal to allow trailing commas in function parameter lists"},"2412":{"id":"/features/trailing-function-commas-11","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"2413":{"id":"/features/trailing-function-commas-12","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"ECMAScript 2017: FormalParameters production"},"2414":{"id":"/features/trailing-function-commas-13","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"ECMA-262 specification, published 2017-06-27, reviewed 2026-07-26"},"2415":{"id":"/features/trailing-function-commas-14","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"ECMAScript 2017: Arguments production"},"2416":{"id":"/features/trailing-function-commas-15","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"ECMA-262 specification, published 2017-06-27, reviewed 2026-07-26"},"2417":{"id":"/features/trailing-function-commas-16","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"TC39 notes: Trailing commas in functions"},"2418":{"id":"/features/trailing-function-commas-17","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"Committee notes, published 2016-07-26, reviewed 2026-07-26"},"2419":{"id":"/features/trailing-function-commas-18","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"Last results of the 113th Ecma General Assembly held in Montreux, June 27, 2017"},"2420":{"id":"/features/trailing-function-commas-19","page_id":"/features/trailing-function-commas","tags":[],"type":"text","url":"/features/trailing-function-commas#sources","content":"Ecma General Assembly record, published 2017-06-27, reviewed 2026-07-26"},"2421":{"id":"/features/ts-54-emit-changes","page_id":"/features/ts-54-emit-changes","type":"page","content":"TypeScript 5.4 emit changes","breadcrumbs":["typescript","TS 5.4"],"tags":[],"url":"/features/ts-54-emit-changes"},"2422":{"id":"/features/ts-54-emit-changes-0","page_id":"/features/ts-54-emit-changes","type":"heading","tags":[],"url":"/features/ts-54-emit-changes#typescript-54-emit-changes","content":"TypeScript 5.4 emit changes"},"2423":{"id":"/features/ts-54-emit-changes-1","page_id":"/features/ts-54-emit-changes","type":"heading","tags":[],"url":"/features/ts-54-emit-changes#what-it-does","content":"What it does"},"2424":{"id":"/features/ts-54-emit-changes-2","page_id":"/features/ts-54-emit-changes","type":"heading","tags":[],"url":"/features/ts-54-emit-changes#migration","content":"Migration"},"2425":{"id":"/features/ts-54-emit-changes-3","page_id":"/features/ts-54-emit-changes","type":"heading","tags":[],"url":"/features/ts-54-emit-changes#compatibility","content":"Compatibility"},"2426":{"id":"/features/ts-54-emit-changes-4","page_id":"/features/ts-54-emit-changes","type":"heading","tags":[],"url":"/features/ts-54-emit-changes#sources","content":"Primary sources"},"2427":{"id":"/features/ts-54-emit-changes-5","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#typescript-54-emit-changes","content":"JavaScript and declaration output changes in several syntax-preservation and downlevel cases."},"2428":{"id":"/features/ts-54-emit-changes-6","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#what-it-does","content":"Emit preserves shadowed type-parameter names more often, moves complex async parameters into the downlevel generator body, retains binding aliases in function declarations, and processes import-type attributes through the normal emit phases."},"2429":{"id":"/features/ts-54-emit-changes-7","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#migration","content":"Regenerate committed output and snapshot fixtures for projects that assert exact JavaScript or declaration text. The release notes state that projects may depend on emit output implicitly."},"2430":{"id":"/features/ts-54-emit-changes-8","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#compatibility","content":"Generated-text snapshots and tools that consume exact compiler output can observe these changes even when source-level behavior is unchanged."},"2431":{"id":"/features/ts-54-emit-changes-9","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"Announcing TypeScript 5.4"},"2432":{"id":"/features/ts-54-emit-changes-10","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"TypeScript release announcement, published 2024-03-06, reviewed 2026-07-24"},"2433":{"id":"/features/ts-54-emit-changes-11","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"TypeScript 5.4 release notes: emit changes"},"2434":{"id":"/features/ts-54-emit-changes-12","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"TypeScript release notes, reviewed 2026-07-24"},"2435":{"id":"/features/ts-54-emit-changes-13","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"TypeScript 5.4 stable release"},"2436":{"id":"/features/ts-54-emit-changes-14","page_id":"/features/ts-54-emit-changes","tags":[],"type":"text","url":"/features/ts-54-emit-changes#sources","content":"Release tag, published 2024-03-06, reviewed 2026-07-24"},"2437":{"id":"/features/ts-arbitrary-module-identifiers","page_id":"/features/ts-arbitrary-module-identifiers","type":"page","content":"Arbitrary module identifiers","breadcrumbs":["typescript","TS 5.6"],"tags":[],"url":"/features/ts-arbitrary-module-identifiers"},"2438":{"id":"/features/ts-arbitrary-module-identifiers-0","page_id":"/features/ts-arbitrary-module-identifiers","type":"heading","tags":[],"url":"/features/ts-arbitrary-module-identifiers#arbitrary-module-identifiers","content":"Arbitrary module identifiers"},"2439":{"id":"/features/ts-arbitrary-module-identifiers-1","page_id":"/features/ts-arbitrary-module-identifiers","type":"heading","tags":[],"url":"/features/ts-arbitrary-module-identifiers#what-it-does","content":"What it does"},"2440":{"id":"/features/ts-arbitrary-module-identifiers-2","page_id":"/features/ts-arbitrary-module-identifiers","type":"heading","tags":[],"url":"/features/ts-arbitrary-module-identifiers#before--after","content":"Before / after"},"2441":{"id":"/features/ts-arbitrary-module-identifiers-3","page_id":"/features/ts-arbitrary-module-identifiers","type":"heading","tags":[],"url":"/features/ts-arbitrary-module-identifiers#sources","content":"Primary sources"},"2442":{"id":"/features/ts-arbitrary-module-identifiers-4","page_id":"/features/ts-arbitrary-module-identifiers","tags":[],"type":"text","url":"/features/ts-arbitrary-module-identifiers#arbitrary-module-identifiers","content":"Imports and exports can name bindings with string literals that are not JavaScript identifiers."},"2443":{"id":"/features/ts-arbitrary-module-identifiers-5","page_id":"/features/ts-arbitrary-module-identifiers","tags":[],"type":"text","url":"/features/ts-arbitrary-module-identifiers#what-it-does","content":"An export can alias a local binding to a string name, and an import can bind that string name to a valid local identifier. The syntax supports generated modules and cross-language interfaces whose export names follow different identifier rules."},"2444":{"id":"/features/ts-arbitrary-module-identifiers-6","page_id":"/features/ts-arbitrary-module-identifiers","tags":[],"type":"text","url":"/features/ts-arbitrary-module-identifiers#sources","content":"Announcing TypeScript 5.6"},"2445":{"id":"/features/ts-arbitrary-module-identifiers-7","page_id":"/features/ts-arbitrary-module-identifiers","tags":[],"type":"text","url":"/features/ts-arbitrary-module-identifiers#sources","content":"TypeScript release announcement, published 2024-09-09, reviewed 2026-07-24"},"2446"