eatures/error-cause#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"613":{"id":"/features/error-cause-26","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"ECMAScript 2022: CreateNonEnumerableDataPropertyOrThrow"},"614":{"id":"/features/error-cause-27","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"615":{"id":"/features/error-cause-28","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"TC39 notes: Error Cause for Stage 4"},"616":{"id":"/features/error-cause-29","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"Committee notes, published 2021-10-26, reviewed 2026-07-26"},"617":{"id":"/features/error-cause-30","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"Node.js 16.9.0 release: Error cause"},"618":{"id":"/features/error-cause-31","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"Runtime release announcement, reviewed 2026-07-26"},"619":{"id":"/features/error-cause-32","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"Ecma International approves new standards at the 123rd General Assembly"},"620":{"id":"/features/error-cause-33","page_id":"/features/error-cause","tags":[],"type":"text","url":"/features/error-cause#sources","content":"Ecma General Assembly record, published 2022-06-22, reviewed 2026-07-26"},"621":{"id":"/features/error-is-error","page_id":"/features/error-is-error","type":"page","content":"Error.isError","breadcrumbs":["ecmascript","ES2026"],"tags":[],"url":"/features/error-is-error"},"622":{"id":"/features/error-is-error-0","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#erroriserror","content":"Error.isError"},"623":{"id":"/features/error-is-error-1","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#what-it-does","content":"What it does"},"624":{"id":"/features/error-is-error-2","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#before--after","content":"Before / after"},"625":{"id":"/features/error-is-error-3","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#gotchas","content":"Gotchas"},"626":{"id":"/features/error-is-error-4","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#support","content":"Support"},"627":{"id":"/features/error-is-error-5","page_id":"/features/error-is-error","type":"heading","tags":[],"url":"/features/error-is-error#sources","content":"Primary sources"},"628":{"id":"/features/error-is-error-6","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#erroriserror","content":"`Error.isError` performs an internal brand check for native error objects."},"629":{"id":"/features/error-is-error-7","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#what-it-does","content":"The specification checks the `[[ErrorData]]` internal slot. The method returns true for `Error`, native error subclasses, and `AggregateError` instances, including instances created in another realm. It returns false for primitives and objects that only imitate an error's properties or string tag. The proposal explains why `instanceof` and `Object.prototype.toString` are insufficient brand checks."},"630":{"id":"/features/error-is-error-8","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#gotchas","content":"The check identifies native error branding, not whether a value was thrown or contains particular fields. JavaScript permits any value to be thrown, so caught values still require separate handling when `Error.isError` returns false."},"631":{"id":"/features/error-is-error-9","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Engine or tool"},"632":{"id":"/features/error-is-error-10","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Version"},"633":{"id":"/features/error-is-error-11","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Source"},"634":{"id":"/features/error-is-error-12","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Retrieved"},"635":{"id":"/features/error-is-error-13","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Node.js"},"636":{"id":"/features/error-is-error-14","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"24.0.0"},"637":{"id":"/features/error-is-error-15","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"2026-07-26"},"638":{"id":"/features/error-is-error-16","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Node.js"},"639":{"id":"/features/error-is-error-17","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"24.3.0"},"640":{"id":"/features/error-is-error-18","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"2026-07-26"},"641":{"id":"/features/error-is-error-19","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#support","content":"Between those t