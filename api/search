ted","content":"deferred-module-evaluation"},"3011":{"id":"/features/ts-import-defer-10","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"Announcing TypeScript 5.9"},"3012":{"id":"/features/ts-import-defer-11","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"TypeScript release announcement, published 2025-08-01, reviewed 2026-07-26"},"3013":{"id":"/features/ts-import-defer-12","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"TypeScript 5.9 release notes: import defer"},"3014":{"id":"/features/ts-import-defer-13","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3015":{"id":"/features/ts-import-defer-14","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"TypeScript 5.9 stable release"},"3016":{"id":"/features/ts-import-defer-15","page_id":"/features/ts-import-defer","tags":[],"type":"text","url":"/features/ts-import-defer#sources","content":"Release tag, reviewed 2026-07-23"},"3017":{"id":"/features/ts-inferred-type-predicates","page_id":"/features/ts-inferred-type-predicates","type":"page","content":"Inferred type predicates","breadcrumbs":["typescript","TS 5.5"],"tags":[],"url":"/features/ts-inferred-type-predicates"},"3018":{"id":"/features/ts-inferred-type-predicates-0","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#inferred-type-predicates","content":"Inferred type predicates"},"3019":{"id":"/features/ts-inferred-type-predicates-1","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#what-it-does","content":"What it does"},"3020":{"id":"/features/ts-inferred-type-predicates-2","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#before--after","content":"Before / after"},"3021":{"id":"/features/ts-inferred-type-predicates-3","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#migration","content":"Migration"},"3022":{"id":"/features/ts-inferred-type-predicates-4","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#compatibility","content":"Compatibility"},"3023":{"id":"/features/ts-inferred-type-predicates-5","page_id":"/features/ts-inferred-type-predicates","type":"heading","tags":[],"url":"/features/ts-inferred-type-predicates#sources","content":"Primary sources"},"3024":{"id":"/features/ts-inferred-type-predicates-6","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#inferred-type-predicates","content":"Eligible boolean-returning functions infer `parameter is Type` predicates from their control-flow refinements."},"3025":{"id":"/features/ts-inferred-type-predicates-7","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#what-it-does","content":"Inference requires one explicit return, no explicit return type, no parameter mutation, and a boolean expression tied to a parameter refinement. Array filtering can therefore remove `undefined` or `null` from the result type."},"3026":{"id":"/features/ts-inferred-type-predicates-8","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#migration","content":"Annotate the variable or the function's return type where the broader element type is required, which suppresses the inferred predicate."},"3027":{"id":"/features/ts-inferred-type-predicates-9","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#compatibility","content":"The narrower result can reject later writes that were accepted when the same expression inferred a broader array type. The release notes show filtering that removes `undefined` from the result type."},"3028":{"id":"/features/ts-inferred-type-predicates-10","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"Announcing TypeScript 5.5"},"3029":{"id":"/features/ts-inferred-type-predicates-11","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"TypeScript release announcement, published 2024-06-20, reviewed 2026-07-26"},"3030":{"id":"/features/ts-inferred-type-predicates-12","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"TypeScript 5.5 release notes: inferred type predicates"},"3031":{"id":"/features/ts-inferred-type-predicates-13","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3032":{"id":"/features/ts-inferred-type-predicates-14","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"TypeScript 5.5 stable release"},"3033":{"id":"/features/ts-inferred-type-predicates-15","page_id":"/features/ts-inferred-type-predicates","tags":[],"type":"text","url":"/features/ts-inferred-type-predicates#sources","content":"Release tag, published 2024-06-20, reviewed 2026-07-24"},"3034":{"id":"/features/ts-isolated-declarations","page_id":"/features/ts-isolated-declarations","type":"page","content":"Isolated declarations","breadcrumbs":["typescript","TS 5.5"],"tags":[],"url":"/features/ts-isolated-declarations"},"3035":{"id":"/features/ts-isolated-declarations-0","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#isolated-declarations","content":"Isolated declarations"},"3036":{"id":"/features/ts-isolated-declarations-1","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#what-it-does","content":"What it does"},"3037":{"id":"/features/ts-isolated-declarations-2","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#before--after","content":"Before / after"},"3038":{"id":"/features/ts-isolated-declarations-3","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#gotchas","content":"Gotchas"},"3039":{"id":"/features/ts-isolated-declarations-4","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#related","content":"Related"},"3040":{"id":"/features/ts-isolated-declarations-5","page_id":"/features/ts-isolated-declarations","type":"heading","tags":[],"url":"/features/ts-isolated-declarations#sources","content":"Primary sources"},"3041":{"id":"/features/ts-isolated-declarations-6","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#isolated-declarations","content":"`isolatedDeclarations` requires exported declarations to carry enough type information for single-file declaration emit."},"3042":{"id":"/features/ts-isolated-declarations-7","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#what-it-does","content":"The option reports exports whose declaration types require cross-file inference. Explicit annotations and supported syntactic inference let declaration tools emit files without constructing a whole-program type graph."},"3043":{"id":"/features/ts-isolated-declarations-8","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#gotchas","content":"The option requires `declaration` or `composite` and does not change JavaScript emit. It checks whether isolated declaration generation is safe; it is not itself a separate emitter."},"3044":{"id":"/features/ts-isolated-declarations-9","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#related","content":"ts-transpile-declaration"},"3045":{"id":"/features/ts-isolated-declarations-10","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"Announcing TypeScript 5.5"},"3046":{"id":"/features/ts-isolated-declarations-11","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"TypeScript release announcement, published 2024-06-20, reviewed 2026-07-26"},"3047":{"id":"/features/ts-isolated-declarations-12","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"TypeScript 5.5 release notes: isolated declarations"},"3048":{"id":"/features/ts-isolated-declarations-13","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3049":{"id":"/features/ts-isolated-declarations-14","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"TypeScript 5.5 stable release"},"3050":{"id":"/features/ts-isolated-declarations-15","page_id":"/features/ts-isolated-declarations","tags":[],"type":"text","url":"/features/ts-isolated-declarations#sources","content":"Release tag, published 2024-06-20, reviewed 2026-07-24"},"3051":{"id":"/features/ts-isolated-type-import-conflicts","page_id":"/features/ts-isolated-type-import-conflicts","type":"page","content":"Isolated type import conflicts","breadcrumbs":["typescript","TS 5.4"],"tags":[],"url":"/features/ts-isolated-type-import-conflicts"},"3052":{"id":"/features/ts-isolated-type-import-conflicts-0","page_id":"/features/ts-isolated-type-import-conflicts","type":"heading","tags":[],"url":"/features/ts-isolated-type-import-conflicts#isolated-type-import-conflicts","content":"Isolated type import conflicts"},"3053":{"id":"/features/ts-isolated-type-import-conflicts-1","page_id":"/features/ts-isolated-type-import-conflicts","type":"heading","tags":[],"url":"/features/ts-isolated-type-import-conflicts#what-it-does","content":"What it does"},"3054":{"id":"/features/ts-isolated-type-import-conflicts-2","page_id":"/features/ts-isolated-type-import-conflicts","type":"heading","tags":[],"url":"/features/ts-isolated-type-import-conflicts#before--after","content":"Before / after"},"3055":{"id":"/features/ts-isolated-type-import-conflicts-3","page_id":"/features/ts-isolated-type-import-conflicts","type":"heading","tags":[],"url":"/features/ts-isolated-type-import-conflicts#migration","content":"Migration"},"3056":{"id":"/features/ts-isolated-type-import-conflicts-4","page_id":"/features/ts-isolated-type-import-conflicts","type":"heading","tags":[],"url":"/features/ts-isolated-type-import-conflicts#sources","content":"Primary sources"},"3057":{"id":"/features/ts-isolated-type-import-conflicts-5","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#isolated-type-import-conflicts","content":"Under `isolatedModules`, an imported type cannot share a name with a local value unless the import is explicitly type-only."},"3058":{"id":"/features/ts-isolated-type-import-conflicts-6","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#what-it-does","content":"A value import whose binding is only used as a type, declared alongside a local value of the same name, reports that the import conflicts with the local value and must be type-only under `isolatedModules`. A single-file compiler cannot otherwise decide whether erasing the import is safe."},"3059":{"id":"/features/ts-isolated-type-import-conflicts-7","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#migration","content":"Use `import type`, add an inline `type` modifier, or rename one binding. These forms give single-file compilers enough information to erase the import safely."},"3060":{"id":"/features/ts-isolated-type-import-conflicts-8","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"Announcing TypeScript 5.4"},"3061":{"id":"/features/ts-isolated-type-import-conflicts-9","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"TypeScript release announcement, published 2024-03-06, reviewed 2026-07-26"},"3062":{"id":"/features/ts-isolated-type-import-conflicts-10","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"TypeScript 5.4 release notes: type-only import conflicts"},"3063":{"id":"/features/ts-isolated-type-import-conflicts-11","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"3064":{"id":"/features/ts-isolated-type-import-conflicts-12","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"TypeScript 5.4 stable release"},"3065":{"id":"/features/ts-isolated-type-import-conflicts-13","page_id":"/features/ts-isolated-type-import-conflicts","tags":[],"type":"text","url":"/features/ts-isolated-type-import-conflicts#sources","content":"Release tag, published 2024-03-06, reviewed 2026-07-26"},"3066":{"id":"/features/ts-iterator-object-types","page_id":"/features/ts-iterator-object-types","type":"page","content":"Iterator helper object types","breadcrumbs":["typescript","TS 5.6"],"tags":[],"url":"/features/ts-iterator-object-types"},"3067":{"id":"/features/ts-iterator-object-types-0","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#iterator-helper-object-types","content":"Iterator helper object types"},"3068":{"id":"/features/ts-iterator-object-types-1","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#what-it-does","content":"What it does"},"3069":{"id":"/features/ts-iterator-object-types-2","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#before--after","content":"Before / after"},"3070":{"id":"/features/ts-iterator-object-types-3","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#migration","content":"Migration"},"3071":{"id":"/features/ts-iterator-object-types-4","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#compatibility","content":"Compatibility"},"3072":{"id":"/features/ts-iterator-object-types-5","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#related","content":"Related"},"3073":{"id":"/features/ts-iterator-object-types-6","page_id":"/features/ts-iterator-object-types","type":"heading","tags":[],"url":"/features/ts-iterator-object-types#sources","content":"Primary sources"},"3074":{"id":"/features/ts-iterator-object-types-7","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#iterator-helper-object-types","content":"Library declarations distinguish runtime iterator objects from the structural `Iterator` protocol."},"3075":{"id":"/features/ts-iterator-object-types-8","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#what-it-does","content":"`IteratorObject` extends `Iterator` and returns itself from `[Symbol.iterator]()`. Built-in array, map, set, and generator iterators use specialized subtypes and expose the ECMAScript iterator helper methods. `AsyncIteratorObject` supplies the parallel type shape without a runtime constructor."},"3076":{"id":"/features/ts-iterator-object-types-9","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#migration","content":"Annotate values produced by built-in collections and generators with `IteratorObject` or a specific subtype such as `ArrayIterator`, `MapIterator`, or `SetIterator` when the helper methods must be visible, and keep `Iterable` or `Iterator` for positions that only require the protocol."},"3077":{"id":"/features/ts-iterator-object-types-10","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#compatibility","content":"Library types that previously returned broad iterator interfaces can expose more specific generic parameters and methods, affecting structural assignments and declaration augmentation."},"3078":{"id":"/features/ts-iterator-object-types-11","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#related","content":"iterator-helpers"},"3079":{"id":"/features/ts-iterator-object-types-12","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"Announcing TypeScript 5.6"},"3080":{"id":"/features/ts-iterator-object-types-13","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"TypeScript release announcement, published 2024-09-09, reviewed 2026-07-24"},"3081":{"id":"/features/ts-iterator-object-types-14","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"TypeScript 5.6 release notes: iterator helper object types"},"3082":{"id":"/features/ts-iterator-object-types-15","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"TypeScript release notes, reviewed 2026-07-24"},"3083":{"id":"/features/ts-iterator-object-types-16","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"TypeScript 5.6 stable release"},"3084":{"id":"/features/ts-iterator-object-types-17","page_id":"/features/ts-iterator-object-types","tags":[],"type":"text","url":"/features/ts-iterator-object-types#sources","content":"Release tag, published 2024-09-09, reviewed 2026-07-24"},"3085":{"id":"/features/ts-javascript-jsdoc-changes","page_id":"/features/ts-javascript-jsdoc-changes","type":"page","content":"JavaScript and JSDoc checking changes","breadcrumbs":["typescript","TS 7.0"],"tags":[],"url":"/features/ts-javascript-jsdoc-changes"},"3086":{"id":"/features/ts-javascript-jsdoc-changes-0","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#javascript-and-jsdoc-checking-changes","content":"JavaScript and JSDoc checking changes"},"3087":{"id":"/features/ts-javascript-jsdoc-changes-1","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#what-it-does","content":"What it does"},"3088":{"id":"/features/ts-javascript-jsdoc-changes-2","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#before--after","content":"Before / after"},"3089":{"id":"/features/ts-javascript-jsdoc-changes-3","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#migration","content":"Migration"},"3090":{"id":"/features/ts-javascript-jsdoc-changes-4","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#compatibility","content":"Compatibility"},"3091":{"id":"/features/ts-javascript-jsdoc-changes-5","page_id":"/features/ts-javascript-jsdoc-changes","type":"heading","tags":[],"url":"/features/ts-javascript-jsdoc-changes#sources","content":"Primary sources"},"3092":{"id":"/features/ts-javascript-jsdoc-changes-6","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#javascript-and-jsdoc-checking-changes","content":"JavaScript checking removes legacy JSDoc constructs and inference patterns that diverged from TypeScript-file analysis."},"3093":{"id":"/features/ts-javascript-jsdoc-changes-7","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#what-it-does","content":"Values in type positions require `typeof`; `@enum`, standalone `?`, `@class`, postfix `!`, and Closure-style function types lose special handling. Type aliases require a named `@typedef`. Aliased `this` variables and wholesale function-prototype assignments no longer receive their earlier inference treatment."},"3094":{"id":"/features/ts-javascript-jsdoc-changes-8","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#migration","content":"Replace removed JSDoc forms with the TypeScript-style equivalents listed in the announcement. Use class declarations for constructors, `any` for standalone unknown JSDoc types, `typeof` for values in type positions, and arrow-style callable types."},"3095":{"id":"/features/ts-javascript-jsdoc-changes-9","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#compatibility","content":"Affected `.js` files can receive different inferred types or new diagnostics even when equivalent `.ts` code is unchanged. The native repository tracks additional port differences in its changes file."},"3096":{"id":"/features/ts-javascript-jsdoc-changes-10","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"Announcing TypeScript 7.0 § javascript-differences"},"3097":{"id":"/features/ts-javascript-jsdoc-changes-11","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"TypeScript release announcement, published 2026-07-08, reviewed 2026-07-23"},"3098":{"id":"/features/ts-javascript-jsdoc-changes-12","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"typescript-go stable changes from TypeScript 6.0"},"3099":{"id":"/features/ts-javascript-jsdoc-changes-13","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"Compiler source, reviewed 2026-07-23"},"3100":{"id":"/features/ts-javascript-jsdoc-changes-14","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"typescript/v7.0.2 stable release"},"3101":{"id":"/features/ts-javascript-jsdoc-changes-15","page_id":"/features/ts-javascript-jsdoc-changes","tags":[],"type":"text","url":"/features/ts-javascript-jsdoc-changes#sources","content":"Release tag, published 2026-07-08, reviewed 2026-07-23"},"3102":{"id":"/features/ts-jsdoc-import","page_id":"/features/ts-jsdoc-import","type":"page","content":"JSDoc @import tag","breadcrumbs":["typescript","TS 5.5"],"tags":[],"url":"/features/ts-jsdoc-import"},"3103":{"id":"/features/ts-jsdoc-import-0","page_id":"/features/ts-jsdoc-import","type":"heading","tags":[],"url":"/features/ts-jsdoc-import#jsdoc-import-tag","content":"JSDoc @import tag"},"3104":{"id":"/features/ts-jsdoc-import-1","page_id":"/features/ts-jsdoc-import","type":"heading","tags":[],"url":"/features/ts-jsdoc-import#what-it-does","content":"What it does"},"3105":{"id":"/features/ts-jsdoc-import-2","page_id":"/features/ts-jsdoc-import","type":"heading","tags":[],"url":"/features/ts-jsdoc-import#before--after","content":"Before / after"},"3106":{"id":"/features/ts-jsdoc-import-3","page_id":"/features/ts-jsdoc-import","type":"heading","tags":[],"url":"/features/ts-jsdoc-import#sources","content":"Primary sources"},"3107":{"id":"/features/ts-jsdoc-import-4","page_id":"/features/ts-jsdoc-import","tags":[],"type":"text","url":"/features/ts-jsdoc-import#jsdoc-import-tag","content":"JavaScript files can import types with an ECMAScript-shaped `@import` JSDoc tag."},"3108":{"id":"/features/ts-jsdoc-import-5","page_id":"/features/ts-jsdoc-import","tags":[],"type":"text","url":"/features/ts-jsdoc-import#what-it-does","content":"`/** @import { SomeType } from \"pkg\" */` introduces a type-only name for later JSDoc annotations. Namespace imports are also supported, and neither form emits a runtime import."},"3109":{"id":"/features/ts-jsdoc-import-6","page_id":"/features/ts-jsdoc-import","tags":[],"type":"text","url":"/features/ts-jsdoc-import#sources","content":"Announcing TypeScript 5.5"},"3110":{"id":"/features/ts-jsdoc-import-7","page_id":"/features/ts-jsdoc-import","tags":[],"type":"text","url":"/features/ts-jsdoc-import#sources","content":"TypeScript release announcemen