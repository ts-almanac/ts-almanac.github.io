r","content":"Before / after"},"1769":{"id":"/features/regexp-escape-3","page_id":"/features/regexp-escape","type":"heading","tags":[],"url":"/features/regexp-escape#gotchas","content":"Gotchas"},"1770":{"id":"/features/regexp-escape-4","page_id":"/features/regexp-escape","type":"heading","tags":[],"url":"/features/regexp-escape#related","content":"Related"},"1771":{"id":"/features/regexp-escape-5","page_id":"/features/regexp-escape","type":"heading","tags":[],"url":"/features/regexp-escape#sources","content":"Primary sources"},"1772":{"id":"/features/regexp-escape-6","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#regexpescape","content":"`RegExp.escape` converts a string into text that a regular-expression pattern matches literally."},"1773":{"id":"/features/regexp-escape-7","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#what-it-does","content":"The static method escapes regular-expression syntax, punctuators, whitespace, line terminators, and lone surrogates. It also hex-escapes an initial ASCII letter or digit so concatenating the result after an escape cannot change how the pattern parses."},"1774":{"id":"/features/regexp-escape-8","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#gotchas","content":"The result is pattern source, not a complete `RegExp`, and it is not an inverse for the specification operation that serializes an existing pattern."},"1775":{"id":"/features/regexp-escape-9","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#related","content":"regexp-modifiers"},"1776":{"id":"/features/regexp-escape-10","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#related","content":"duplicate-named-capture-groups"},"1777":{"id":"/features/regexp-escape-11","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"RegExp Escaping Proposal § chosen-solutions"},"1778":{"id":"/features/regexp-escape-12","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"1779":{"id":"/features/regexp-escape-13","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"RegExp Escaping Proposal § how-does-this-relate-to-the-escaperegexppattern-ao"},"1780":{"id":"/features/regexp-escape-14","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"1781":{"id":"/features/regexp-escape-15","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"ECMAScript 2025: RegExp.escape"},"1782":{"id":"/features/regexp-escape-16","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"ECMA-262 specification, published 2025-06-25, reviewed 2026-07-23"},"1783":{"id":"/features/regexp-escape-17","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"TC39 notes: RegExp escaping for Stage 4"},"1784":{"id":"/features/regexp-escape-18","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"Committee notes, published 2025-02-18, reviewed 2026-07-23"},"1785":{"id":"/features/regexp-escape-19","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"Ecma International approves new standards"},"1786":{"id":"/features/regexp-escape-20","page_id":"/features/regexp-escape","tags":[],"type":"text","url":"/features/regexp-escape#sources","content":"Ecma General Assembly record, published 2025-06-26, reviewed 2026-07-23"},"1787":{"id":"/features/regexp-lookbehind-assertions","page_id":"/features/regexp-lookbehind-assertions","type":"page","content":"RegExp lookbehind assertions","breadcrumbs":["ecmascript","ES2018"],"tags":[],"url":"/features/regexp-lookbehind-assertions"},"1788":{"id":"/features/regexp-lookbehind-assertions-0","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#regexp-lookbehind-assertions","content":"RegExp lookbehind assertions"},"1789":{"id":"/features/regexp-lookbehind-assertions-1","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#what-it-does","content":"What it does"},"1790":{"id":"/features/regexp-lookbehind-assertions-2","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#before--after","content":"Before / after"},"1791":{"id":"/features/regexp-lookbehind-assertions-3","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#gotchas","content":"Gotchas"},"1792":{"id":"/features/regexp-lookbehind-assertions-4","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#support","content":"Support"},"1793":{"id":"/features/regexp-lookbehind-assertions-5","page_id":"/features/regexp-lookbehind-assertions","type":"heading","tags":[],"url":"/features/regexp-lookbehind-assertions#sources","content":"Primary sources"},"1794":{"id":"/features/regexp-lookbehind-assertions-6","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#regexp-lookbehind-assertions","content":"`(?<=…)` and `(?<!…)` test what precedes the current position without adding it to the match."},"1795":{"id":"/features/regexp-lookbehind-assertions-7","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#what-it-does","content":"`Assertion` gains the alternatives `(?<= Disjunction )` and `(?<! Disjunction )` beside the existing lookahead forms. Both evaluate their `Disjunction` with a direction argument of `-1` rather than `+1`, so the inner pattern consumes input from the assertion's position towards the start of the string; the positive form keeps the captures its `Disjunction` made, and the negative form succeeds only when the inner match fails."},"1796":{"id":"/features/regexp-lookbehind-assertions-8","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#what-it-does","content":"The proposal takes matching a currency amount without the sign as its case, `/(?<=\\$)\\d+(\\.\\d*)?/` returning `10.53` for `$10.53` and not matching `€10.53`, and states that any pattern is allowed inside the assertion, including an unbounded repetition."},"1797":{"id":"/features/regexp-lookbehind-assertions-9","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#gotchas","content":"Because the inner pattern runs with direction `-1`, greedy quantifiers inside a lookbehind take from the right. The proposal's example is `/(?<=(\\d+)(\\d+))$/` against `\"1053\"`, where group 1 captures `1` and group 2 captures `053`, the mirror image of `/^(\\d+)(\\d+)/`. Numbering itself still reads left to right in the source text, so only the values move."},"1798":{"id":"/features/regexp-lookbehind-assertions-10","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#gotchas","content":"A backreference inside a lookbehind can only name a group that the backward pass has already reached, meaning a group written to its right. `(?<=(.)\\1)` therefore resolves `\\1` against nothing and matches the empty string, while `(?<=\\1(.))` is the useful ordering."},"1799":{"id":"/features/regexp-lookbehind-assertions-11","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#support","content":"V8 enabled both forms by default in 6.2, whose examples contrast `/(?<=\\$)\\d+/` with `/(?<!\\$)\\d+/` on one string."},"1800":{"id":"/features/regexp-lookbehind-assertions-12","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"RegExp Lookbehind Assertions: High Level API"},"1801":{"id":"/features/regexp-lookbehind-assertions-13","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1802":{"id":"/features/regexp-lookbehind-assertions-14","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"RegExp Lookbehind Assertions: Greediness proceeds from right to left"},"1803":{"id":"/features/regexp-lookbehind-assertions-15","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1804":{"id":"/features/regexp-lookbehind-assertions-16","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"RegExp Lookbehind Assertions: Numbering capture groups"},"1805":{"id":"/features/regexp-lookbehind-assertions-17","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1806":{"id":"/features/regexp-lookbehind-assertions-18","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"RegExp Lookbehind Assertions: Referring to capture groups"},"1807":{"id":"/features/regexp-lookbehind-assertions-19","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1808":{"id":"/features/regexp-lookbehind-assertions-20","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"ECMAScript 2018: Patterns"},"1809":{"id":"/features/regexp-lookbehind-assertions-21","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"1810":{"id":"/features/regexp-lookbehind-assertions-22","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"ECMAScript 2018: Assertion"},"1811":{"id":"/features/regexp-lookbehind-assertions-23","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"ECMA-262 specification, published 2018-06-27, reviewed 2026-07-26"},"1812":{"id":"/features/regexp-lookbehind-assertions-24","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 notes: RegExp lookbehind assertions for Stage 4"},"1813":{"id":"/features/regexp-lookbehind-assertions-25","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"Committee notes, published 2018-01-24, reviewed 2026-07-26"},"1814":{"id":"/features/regexp-lookbehind-assertions-26","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"TC39 notes: RegExp lookbehind assertions for Stage 4?"},"1815":{"id":"/features/regexp-lookbehind-assertions-27","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"Committee notes, published 2018-01-23, reviewed 2026-07-26"},"1816":{"id":"/features/regexp-lookbehind-assertions-28","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"V8 release v6.2: More regular expressions features"},"1817":{"id":"/features/regexp-lookbehind-assertions-29","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"Engine record, published 2017-09-11, reviewed 2026-07-26"},"1818":{"id":"/features/regexp-lookbehind-assertions-30","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"Results of the 115th Ecma General Assembly held in Geneva, June 27, 2018"},"1819":{"id":"/features/regexp-lookbehind-assertions-31","page_id":"/features/regexp-lookbehind-assertions","tags":[],"type":"text","url":"/features/regexp-lookbehind-assertions#sources","content":"Ecma General Assembly record, published 2018-06-27, reviewed 2026-07-26"},"1820":{"id":"/features/regexp-match-indices","page_id":"/features/regexp-match-indices","type":"page","content":"RegExp match indices","breadcrumbs":["ecmascript","ES2022"],"tags":[],"url":"/features/regexp-match-indices"},"1821":{"id":"/features/regexp-match-indices-0","page_id":"/features/regexp-match-indices","type":"heading","tags":[],"url":"/features/regexp-match-indices#regexp-match-indices","content":"RegExp match indices"},"1822":{"id":"/features/regexp-match-indices-1","page_id":"/features/regexp-match-indices","type":"heading","tags":[],"url":"/features/regexp-match-indices#what-it-does","content":"What it does"},"1823":{"id":"/features/regexp-match-indices-2","page_id":"/features/regexp-match-indices","type":"heading","tags":[],"url":"/features/regexp-match-indices#before--after","content":"Before / after"},"1824":{"id":"/features/regexp-match-indices-3","page_id":"/features/regexp-match-indices","type":"heading","tags":[],"url":"/features/regexp-match-indices#gotchas","content":"Gotchas"},"1825":{"id":"/features/regexp-match-indices-4","page_id":"/features/regexp-match-indices","type":"heading","tags":[],"url":"/features/regexp-match-indices#sources","content":"Primary sources"},"1826":{"id":"/features/regexp-match-indices-5","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#regexp-match-indices","content":"The `d` flag makes a match result carry an `indices` array holding the start and end offset of the match and of every capture group."},"1827":{"id":"/features/regexp-match-indices-6","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#what-it-does","content":"`RegExpBuiltinExec` sets an internal `hasIndices` from the presence of `d` in the pattern's original flags, and only then adds an `indices` property to the result array. That value is an array of `[start, end]` pairs aligned with the numbered captures, carrying a `groups` property that repeats the pairs under each named group. `RegExp.prototype.hasIndices` is a getter that reports whether the flag is set. The proposal names syntax highlighting as the driving case, where the position of an individual capture matters and not only the position of the whole match, and `d` was picked for the `d` in \"indices\", aligning with `index` and `lastIndex`."},"1828":{"id":"/features/regexp-match-indices-7","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#gotchas","content":"A capture group that did not participate has no pair: an unmatched group's slot is `undefined` rather than an empty range, so `/a+(?<Z>z)?/d.exec(\"xaaay\").indices[1]` is `undefined` and the matching `indices.groups.Z` is too. The `groups` property always exists on the array even when the pattern declares no names, in which case its value is `undefined`, so `Object.hasOwn(match.indices, \"groups\")` is `true` while `match.indices.groups` reads as nothing. Without the flag there is no `indices` property at all, because the result-building step is guarded by `hasIndices`; the search cost of collecting offsets is only paid when the flag opts in."},"1829":{"id":"/features/regexp-match-indices-8","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"RegExp Match Indices for ECMAScript proposal § motivations"},"1830":{"id":"/features/regexp-match-indices-9","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1831":{"id":"/features/regexp-match-indices-10","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"RegExp Match Indices for ECMAScript proposal § why-use-d-for-the-regexp-flag"},"1832":{"id":"/features/regexp-match-indices-11","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1833":{"id":"/features/regexp-match-indices-12","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"ECMAScript 2022: RegExpBuiltinExec"},"1834":{"id":"/features/regexp-match-indices-13","page_id":"/features/regexp-match-indices","tags":[],"type":"text","url":"/features/regexp-match-indices#sources","content":"ECMA-262 specification, published 2022-06-22, reviewed 2026-07-26"},"1835":{"id":"/features/regexp-match-indices-14","page_id":"/features/