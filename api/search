exing-at","tags":[],"type":"text","url":"/features/relative-indexing-at#sources","content":"Committee notes, published 2021-08-31, reviewed 2026-07-26"},"1983":{"id":"/features/relative-indexing-at-22","page_id":"/features/relative-indexing-at","tags":[],"type":"text","url":"/features/relative-indexing-at#sources","content":"Ecma International approves new standards at the 123rd General Assembly"},"1984":{"id":"/features/relative-indexing-at-23","page_id":"/features/relative-indexing-at","tags":[],"type":"text","url":"/features/relative-indexing-at#sources","content":"Ecma General Assembly record, published 2022-06-22, reviewed 2026-07-26"},"1985":{"id":"/features/resizable-arraybuffers","page_id":"/features/resizable-arraybuffers","type":"page","content":"Resizable and growable ArrayBuffers","breadcrumbs":["ecmascript","ES2024"],"tags":[],"url":"/features/resizable-arraybuffers"},"1986":{"id":"/features/resizable-arraybuffers-0","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#resizable-and-growable-arraybuffers","content":"Resizable and growable ArrayBuffers"},"1987":{"id":"/features/resizable-arraybuffers-1","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#what-it-does","content":"What it does"},"1988":{"id":"/features/resizable-arraybuffers-2","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#before--after","content":"Before / after"},"1989":{"id":"/features/resizable-arraybuffers-3","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#gotchas","content":"Gotchas"},"1990":{"id":"/features/resizable-arraybuffers-4","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#related","content":"Related"},"1991":{"id":"/features/resizable-arraybuffers-5","page_id":"/features/resizable-arraybuffers","type":"heading","tags":[],"url":"/features/resizable-arraybuffers#sources","content":"Primary sources"},"1992":{"id":"/features/resizable-arraybuffers-6","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#resizable-and-growable-arraybuffers","content":"Array buffers can reserve a maximum size and change their accessible byte length in place."},"1993":{"id":"/features/resizable-arraybuffers-7","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#what-it-does","content":"An `ArrayBuffer` created with `maxByteLength` can grow or shrink through `resize()`. A `SharedArrayBuffer` created the same way can grow through `grow()` but cannot shrink. The `resizable`, `growable`, and `maxByteLength` accessors expose those capabilities."},"1994":{"id":"/features/resizable-arraybuffers-8","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#gotchas","content":"A typed-array view without an explicit length tracks a resizable backing buffer. A fixed-length view can become out of bounds after shrinking and becomes usable again if a later resize restores its range. New memory is zeroed."},"1995":{"id":"/features/resizable-arraybuffers-9","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#related","content":"arraybuffer-transfer"},"1996":{"id":"/features/resizable-arraybuffers-10","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#sources","content":"Resizable and growable ArrayBuffers proposal § proposal"},"1997":{"id":"/features/resizable-arraybuffers-11","page_id":"/features/resizable-arraybuffers","tags":[],"type":"text","url":"/features/resizable-arraybuffers#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"1998":{"id":"/features/resizable-arraybuffers