ule-format-node-modules#what-it-does","content":"Inside `node_modules`, `.mjs`, `.cjs`, `.mts`, `.cts`, and the nearest `package.json` `type` field influence resolution outside the Node-specific modes. `.mts` files never emit CommonJS, and `.cts` files never emit ECMAScript modules. AMD, UMD, and System modes retain their existing behavior."},"3280":{"id":"/features/ts-module-format-node-modules-7","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#migration","content":"Use the extension and package type that match runtime format, and replace unsafe default imports from ECMAScript dependencies."},"3281":{"id":"/features/ts-module-format-node-modules-8","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"Announcing TypeScript 5.6"},"3282":{"id":"/features/ts-module-format-node-modules-9","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"TypeScript release announcement, published 2024-09-09, reviewed 2026-07-24"},"3283":{"id":"/features/ts-module-format-node-modules-10","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"TypeScript 5.6 release notes: dependency module formats"},"3284":{"id":"/features/ts-module-format-node-modules-11","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"TypeScript release notes, reviewed 2026-07-24"},"3285":{"id":"/features/ts-module-format-node-modules-12","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"TypeScript 5.6 stable release"},"3286":{"id":"/features/ts-module-format-node-modules-13","page_id":"/features/ts-module-format-node-modules","tags":[],"type":"text","url":"/features/ts-module-format-node-modules#sources","content":"Release tag, published 2024-09-09, reviewed 2026-07-24"},"3287":{"id":"/features/ts-module-interop-deprecations","page_id":"/features/ts-module-interop-deprecations","type":"page","content":"Disabled module-interop deprecations","breadcrumbs":["typescript","TS 6.0"],"tags":[],"url":"/features/ts-module-interop-deprecations"},"3288":{"id":"/features/ts-module-interop-deprecations-0","page_id":"/features/ts-module-interop-deprecations","type":"heading","tags":[],"url":"/features/ts-module-interop-deprecations#disabled-module-interop-deprecations","content":"Disabled module-interop deprecations"},"3289":{"id":"/features/ts-module-interop-deprecations-1","page_id":"/features/ts-module-interop-deprecations","type":"heading","tags":[],"url":"/features/ts-module-interop-deprecations#what-it-does","content":"What it does"},"3290":{"id":"/features/ts-module-interop-deprecations-2","page_id":"/features/ts-module-interop-deprecations","type":"heading","tags":[],"url":"/features/ts-module-interop-deprecations#migration","content":"Migration"},"3291":{"id":"/features/ts-module-interop-deprecations-3","page_id":"/features/ts-module-interop-deprecations","type":"heading","tags":[],"url":"/features/ts-module-interop-deprecations#sources","content":"Primary sources"},"3292":{"id":"/features/ts-module-interop-deprecations-4","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#disabled-module-interop-deprecations","content":"Setting `esModuleInterop` or `allowSyntheticDefaultImports` to `false` produces a deprecation diagnostic."},"3293":{"id":"/features/ts-module-interop-deprecations-5","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#what-it-does","content":"The enabled interop behavior becomes the supported direction for CommonJS consumption from ECMAScript modules. The stable compiler retains false settings only through the suppressible deprecation path. The release notes describe the import behavior, and the tag records suppression. The stable compiler checks both false values."},"3294":{"id":"/features/ts-module-interop-deprecations-6","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#migration","content":"Remove false settings and convert namespace-style imports that depend on them to default imports when the imported CommonJS declaration exposes that shape."},"3295":{"id":"/features/ts-module-interop-deprecations-7","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#sources","content":"Announcing TypeScript 6.0"},"3296":{"id":"/features/ts-module-interop-deprecations-8","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#sources","content":"TypeScript release announcement, published 2026-03-23, reviewed 2026-07-23"},"3297":{"id":"/features/ts-module-interop-deprecations-9","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#sources","content":"TypeScript 6.0 release notes: module-interop settings"},"3298":{"id":"/features/ts-module-interop-deprecations-10","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#sources","content":"TypeScript release notes, reviewed 2026-07-23"},"3299":{"id":"/features/ts-module-interop-deprecations-11","page_id":"/features/ts-module-interop-deprecations","tags":[],"type":"text","url":"/features/ts-module-interop-deprecations#sources","content":"TypeScript stable compiler deprecation checks"},"3300":{"id":"/features/ts-module-interop-deprecations-12","page_id":"/features/ts-module-