-error#sources","content":"Ecma General Assembly record, published 2026-07-01, reviewed 2026-07-23"},"652":{"id":"/features/error-is-error-30","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#sources","content":"Node.js 24.0.0 release"},"653":{"id":"/features/error-is-error-31","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#sources","content":"Runtime release announcement, published 2025-05-06, reviewed 2026-07-26"},"654":{"id":"/features/error-is-error-32","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#sources","content":"MDN browser compatibility data: Error"},"655":{"id":"/features/error-is-error-33","page_id":"/features/error-is-error","tags":[],"type":"text","url":"/features/error-is-error#sources","content":"Compatibility data, reviewed 2026-07-26"},"656":{"id":"/features/error-stack-accessor","page_id":"/features/error-stack-accessor","type":"page","content":"Error Stack Accessor","breadcrumbs":["ecmascript","ESNext"],"tags":[],"url":"/features/error-stack-accessor"},"657":{"id":"/features/error-stack-accessor-0","page_id":"/features/error-stack-accessor","type":"heading","tags":[],"url":"/features/error-stack-accessor#error-stack-accessor","content":"Error Stack Accessor"},"658":{"id":"/features/error-stack-accessor-1","page_id":"/features/error-stack-accessor","type":"heading","tags":[],"url":"/features/error-stack-accessor#what-it-does","content":"What it does"},"659":{"id":"/features/error-stack-accessor-2","page_id":"/features/error-stack-accessor","type":"heading","tags":[],"url":"/features/error-stack-accessor#before--after","content":"Before / after"},"660":{"id":"/features/error-stack-accessor-3","page_id":"/features/error-stack-accessor","type":"heading","tags":[],"url":"/features/error-stack-accessor#gotchas","content":"Gotchas"},"661":{"id":"/features/error-stack-accessor-4","page_id":"/features/error-stack-accessor","type":"heading","tags":[],"url":"/features/error-stack-accessor#sources","content":"Primary sources"},"662":{"id":"/features/error-stack-accessor-5","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#error-stack-accessor","content":"`Error.prototype.stack` becomes a specified accessor while the stack string remains implementation-defined."},"663":{"id":"/features/error-stack-accessor-6","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#what-it-does","content":"The configurable, non-enumerable getter returns an implementation-defined stack string for an Error object and `undefined` for another object. The setter installs an own `stack` property on an Error object."},"664":{"id":"/features/error-stack-accessor-7","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#gotchas","content":"The proposal does not standardize stack-frame syntax, file paths, line formatting, capture timing, or security redaction. Calling the getter with a primitive receiver throws a `TypeError`."},"665":{"id":"/features/error-stack-accessor-8","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"TC39 active proposals at the cutoff"},"666":{"id":"/features/error-stack-accessor-9","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"TC39 stage record, published 2026-07-22, reviewed 2026-07-23"},"667":{"id":"/features/error-stack-accessor-10","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"Error Stack Accessor § rationale"},"668":{"id":"/features/error-stack-accessor-11","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"669":{"id":"/features/error-stack-accessor-12","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"Error Stack Accessor draft specification"},"670":{"id":"/features/error-stack-accessor-13","page_id":"/features/error-stack-accessor","tags":[],"type":"text","url":"/features/error-stack-accessor#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"671":{"id":"/features/explicit-resource-management","page_id":"/features/explicit-resource-management","type":"page","content":"Explicit Resource Management","breadcrumbs":["ecmascript","ES2027"],"tags":[],"url":"/features/explicit-resource-management"},"672":{"id":"/features/explicit-resource-management-0","page_id":"/features/explicit-resource-management","type":"heading","tags":[],"url":"/features/explicit-resource-management#explicit-resource-management","content":"Explicit Resource Management"},"673":{"id":"/features/explicit-resource-management-1","page_id":"/features/explicit-resource-management","type":"heading","tags":[],"url":"/features/explicit-resource-management#what-it-does","content":"What it does"},"674":{"id":"/features/explicit-resource-management-2","page_id":"/features/explicit-resource-management","type":"heading","tags":[],"url":"/features/explicit-resource-management#before--after","content":"Before / after"},"675":{"id":"/features/explicit-resource-management-3","page_id":"/features/explicit-resource-management","type":"heading","tags":[],"url":"/features/explicit-resource-management#gotchas","content":"Gotchas"},"676":{"id":"/features/explicit-resource-management-4","page_id":"/features/explicit-resource-management","type":"heading","tags":[],"url":"/features/explicit-resource-management#sources","content":"Primary sources"},"677":{"id":"/features/explicit-resource-management-5","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#explicit-resource-management","content":"`using` declarations bind resources that are disposed in reverse order when control leaves their scope."},"678":{"id":"/features/explicit-resource-management-6","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#what-it-does","content":"Synchronous resources implement `[Symbol.dispose]`; asynchronous resources implement `[Symbol.asyncDispose]` or fall back to synchronous disposal under `await using`. `DisposableStack` and `AsyncDisposableStack` provide imperative registration, transfer, and disposal. `SuppressedError` retains both a disposal failure and an exception it replaces."},"679":{"id":"/features/explicit-resource-management-7","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#gotchas","content":"`for await` controls asynchronous iteration and does not imply asynchronous disposal; `await using` is still required for that behavior. A value other than `null` or `undefined` must provide the required disposal method or initialization throws."},"680":{"id":"/features/explicit-resource-management-8","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"ECMAScript Explicit Resource Management § using-declarations"},"681":{"id":"/features/explicit-resource-management-9","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"682":{"id":"/features/explicit-resource-management-10","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"ECMAScript Explicit Resource Management § api"},"683":{"id":"/features/explicit-resource-management-11","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"684":{"id":"/features/explicit-resource-management-12","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"ECMAScript Explicit Resource Management § await-using-in-for-of-and-for-await-of-statements"},"685":{"id":"/features/explicit-resource-management-13","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 proposal repository, reviewed 2026-07-23"},"686":{"id":"/features/explicit-resource-management-14","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 finished proposals at the cutoff"},"687":{"id":"/features/explicit-resource-management-15","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 stage record, published 2026-07-22, reviewed 2026-07-23"},"688":{"id":"/features/explicit-resource-management-16","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"TC39 notes: Explicit Resource Management Stage 4 progress update"},"689":{"id":"/features/explicit-resource-management-17","page_id":"/features/explicit-resource-management","tags":[],"type":"text","url":"/features/explicit-resource-management#sources","content":"Committee notes, published 2026-05-19, reviewed 2026-07-23"},"690":{"id":"/features/exponentiation-operator","page_id":"/features/exponentiation-operator","type":"page","content":"Exponentiation operator","breadcrumbs":["ecmascript","ES2016"],"tags":[],"url":"/features/exponentiation-operator"},"691":{"id":"/features/exponentiation-operator-0","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#exponentiation-operator","content":"Exponentiation operator"},"692":{"id":"/features/exponentiation-operator-1","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#what-it-does","content":"What it does"},"693":{"id":"/features/exponentiation-operator-2","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#before--after","content":"Before / after"},"694":{"id":"/features/exponentiation-operator-3","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#gotchas","content":"Gotchas"},"695":{"id":"/features/exponentiation-operator-4","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#compatibility","content":"Compatibility"},"696":{"id":"/features/exponentiation-operator-5","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#support","content":"Support"},"697":{"id":"/features/exponentiation-operator-6","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#related","content":"Related"},"698":{"id":"/features/exponentiation-operator-7","page_id":"/features/exponentiation-operator","type":"heading","tags":[],"url":"/features/exponentiation-operator#sources","content":"Primary sources"},"699":{"id":"/features/exponentiation-operator-8","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#exponentiation-operator","content":"An infix `**` operator and a `**=` compound assignment raise a number to a power."},"700":{"id":"/features/exponentiation-operator-9","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#what-it-does","content":"The grammar adds `ExponentiationExpression`, whose second production is `UpdateExpression ** ExponentiationExpression`. The right operand is itself an `ExponentiationExpression`, which makes the operator right-associative, and the left operand is an `UpdateExpression`, which excludes a unary operator there. Evaluation applies `ToNumber` to both operand values and then the abstract operation \"Applying the `**` Operator\". That operation returns an implementation-dependent approximation of the base raised to the exponent, and fixes the results for zero, one, infinite, and `NaN` operands."},"701":{"id":"/features/exponentiation-operator-10","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#what-it-does","content":"`**=` joins the `AssignmentOperator` list next to `*=` and `+=`. The same edition redefines `Math.pow` to return the result of applying the `**` operator, so the method and the operator share one algorithm rather than two independently specified ones. The proposal argues for the infix form as being shorter than function notation and cites the operator's use in mathematics, physics, and robotics."},"702":{"id":"/features/exponentiation-operator-11","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#gotchas","content":"A unary operator on the left is a syntax error, not a precedence puzzle, because the left operand production is `UpdateExpression`:"},"703":{"id":"/features/exponentiation-operator-12","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#gotchas","content":"Parentheses are required only on the left; the right operand accepts a `UnaryExpression`, so `2 ** -2` parses. `typeof 2 ** 2` fails for the same reason as `-2 ** 2`."},"704":{"id":"/features/exponentiation-operator-13","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#gotchas","content":"Nesting groups to the right: `2 ** 3 ** 2` is 512 and `(2 ** 3) ** 2` is 64. An exponent of `+0` or `-0` produces 1 even when the base is `NaN`, so `NaN ** 0` is 1, while a `NaN` exponent always produces `NaN`. The result is an approximation the implementation chooses, which is why `**` carries the same rounding as `Math.pow` on the same engine."},"705":{"id":"/features/exponentiation-operator-14","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#compatibility","content":"The 7th edition coerces both operands with `ToNumber`, so at this edition the operator has one numeric type. ECMAScript 2020 replaces those steps with `ToNumeric` and dispatches to the BigInt exponentiation operation when both operands are BigInts, which is what makes `2n ** 10n` evaluate to `1024n` and a mixed `2n ** 2` throw a `TypeError`."},"706":{"id":"/features/exponentiation-operator-15","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#support","content":"V8 5.2 announces the operator as replacing `Math.pow`, and its example uses both the infix form and `**=`."},"707":{"id":"/features/exponentiation-operator-16","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#related","content":"bigint"},"708":{"id":"/features/exponentiation-operator-17","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Exponentiation Operator: Informative"},"709":{"id":"/features/exponentiation-operator-18","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"710":{"id":"/features/exponentiation-operator-19","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Exponentiation Operator: Usage"},"711":{"id":"/features/exponentiation-operator-20","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"712":{"id":"/features/exponentiation-operator-21","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2016: Exponentiation Operator"},"713":{"id":"/features/exponentiation-operator-22","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2016-06-14, reviewed 2026-07-26"},"714":{"id":"/features/exponentiation-operator-23","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2016: Exponentiation Operator, Runtime Semantics: Evaluation"},"715":{"id":"/features/exponentiation-operator-24","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2016-06-14, reviewed 2026-07-26"},"716":{"id":"/features/exponentiation-operator-25","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2016: Applying the \\*\\* Operator"},"717":{"id":"/features/exponentiation-operator-26","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2016-06-14, reviewed 2026-07-26"},"718":{"id":"/features/exponentiation-operator-27","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2016: Assignment Operators"},"719":{"id":"/features/exponentiation-operator-28","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2016-06-14, reviewed 2026-07-26"},"720":{"id":"/features/exponentiation-operator-29","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2016: Math.pow ( base, exponent )"},"721":{"id":"/features/exponentiation-operator-30","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2016-06-14, reviewed 2026-07-26"},"722":{"id":"/features/exponentiation-operator-31","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMAScript 2020: Exponentiation Operator, Runtime Semantics: Evaluation"},"723":{"id":"/features/exponentiation-operator-32","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"ECMA-262 specification, published 2020-06-16, reviewed 2026-07-26"},"724":{"id":"/features/exponentiation-operator-33","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"TC39 notes: 5.xviii Exponentiation Operator"},"725":{"id":"/features/exponentiation-operator-34","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Committee notes, published 2016-01-28, reviewed 2026-07-26"},"726":{"id":"/features/exponentiation-operator-35","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"V8 release v5.2: Exponentiation operator"},"727":{"id":"/features/exponentiation-operator-36","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Engine record, published 2016-06-04, reviewed 2026-07-26"},"728":{"id":"/features/exponentiation-operator-37","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Last results of the 111th General Assembly held in Montreux, June 14, 2016"},"729":{"id":"/features/exponentiation-operator-38","page_id":"/features/exponentiation-operator","tags":[],"type":"text","url":"/features/exponentiation-operator#sources","content":"Ecma General Assembly record, published 2016-06-14, reviewed 2026-07-26"},"730":{"id":"/features/finalization-registry","page_id":"/features/finalization-registry","type":"page","content":"FinalizationRegistry","breadcrumbs":["ecmascript","ES2021"],"tags":[],"url":"/features/finalization-registry"},"731":{"id":"/features/finalization-registry-0","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#finalizationregistry","content":"FinalizationRegistry"},"732":{"id":"/features/finalization-registry-1","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#what-it-does","content":"What it does"},"733":{"id":"/features/finalization-registry-2","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#before--after","content":"Before / after"},"734":{"id":"/features/finalization-registry-3","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#gotchas","content":"Gotchas"},"735":{"id":"/features/finalization-registry-4","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#support","content":"Support"},"736":{"id":"/features/finalization-registry-5","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#related","content":"Related"},"737":{"id":"/features/finalization-registry-6","page_id":"/features/finalization-registry","type":"heading","tags":[],"url":"/features/finalization-registry#sources","content":"Primary sources"},"738":{"id":"/features/finalization-registry-7","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#finalizationregistry","content":"A `FinalizationRegistry` calls one callback with a registered held value after the garbage collector reclaims the object it was registered against."},"739":{"id":"/features/finalization-registry-8","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#what-it-does","content":"`new FinalizationRegistry(cleanupCallback)` requires `new` and a callable argument, then stores that callback with an empty cell list and the realm of the constructor. `register(target, heldValue, unregisterToken)` appends a cell recording all three, rejecting a non-object target, a token that is neither an object nor `undefined`, and a `heldValue` that is the same value as the target. `unregister(token)` removes every cell whose recorded token matches and reports whether anything was removed. `CleanupFinalizationRegistry` states that an implementation *may* remove a cell whose target has been cleared and call the callback with that cell's held value. Scheduling belongs to the host, which is expected to make that call later without interrupting synchronous execution. The proposal's motivating case is a weak cache whose map entries would otherwise accumulate after their values are collected."},"740":{"id":"/features/finalization-registry-9","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#gotchas","content":"Registering an object as its own held value throws a `TypeError`, because the check is `SameValue(target, heldValue)`: a cell's held value stays strongly reachable while the cell exists, so that combination would keep the target from ever being collected. A callback is never a guarantee, since the cleanup operation is written as something an implementation may do; the proposal names process exit and an unreachable registry as cases where callbacks do not run. Callbacks also arrive later than the clearing they report, which is why the example rechecks the cache before deleting: the proposal describes weak references being cleared while the matching handler runs only in a later task. Unregistration needs a token that was passed at registration time and is object-typed, so `unregister(\"cover\")` throws rather than reporting `false`, and a registration made without a token cannot be removed at all."},"741":{"id":"/features/finalization-registry-10","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#support","content":"V8 shipped the registry in 8.4, whose notes state that finalizers run on the event loop and never interrupt synchronous JavaScript."},"742":{"id":"/features/finalization-registry-11","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#related","content":"weakref"},"743":{"id":"/features/finalization-registry-12","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#related","content":"symbols-as-weakmap-keys"},"744":{"id":"/features/finalization-registry-13","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"WeakRefs TC39 proposal § weak-caches"},"745":{"id":"/features/finalization-registry-14","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"746":{"id":"/features/finalization-registry-15","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"WeakRefs TC39 proposal § another-note-of-caution"},"747":{"id":"/features/finalization-registry-16","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"748":{"id":"/features/finalization-registry-17","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"WeakRefs TC39 proposal § using-weakref-objects-and-finalizationregistry-objects-together"},"749":{"id":"/features/finalization-registry-18","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"750":{"id":"/features/finalization-registry-19","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMAScript 2021: FinalizationRegistry ( cleanupCallback )"},"751":{"id":"/features/finalization-registry-20","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"752":{"id":"/features/finalization-registry-21","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMAScript 2021: FinalizationRegistry.prototype.register ( target, heldValue \\[ , unregisterToken ] )"},"753":{"id":"/features/finalization-registry-22","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"754":{"id":"/features/finalization-registry-23","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMAScript 2021: FinalizationRegistry.prototype.unregister ( unregisterToken )"},"755":{"id":"/features/finalization-registry-24","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"756":{"id":"/features/finalization-registry-25","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMAScript 2021: CleanupFinalizationRegistry"},"757":{"id":"/features/finalization-registry-26","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"758":{"id":"/features/finalization-registry-27","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMAScript 2021: HostEnqueueFinalizationRegistryCleanupJob"},"759":{"id":"/features/finalization-registry-28","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"ECMA-262 specification, published 2021-06-22, reviewed 2026-07-26"},"760":{"id":"/features/finalization-registry-29","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"TC39 notes: WeakRefs for Stage 4 / CleanupSome for Stage 2/3"},"761":{"id":"/features/finalization-registry-30","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"Committee notes, published 2020-07-21, reviewed 2026-07-26"},"762":{"id":"/features/finalization-registry-31","page_id":"/features/finalization-registry","tags":[],"type":"text","url":"/features/finalization-registry#sources","content":"V8 release