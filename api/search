-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"Announcing TypeScript 5.8"},"2572":{"id":"/features/ts-computed-declaration-names-11","page_id":"/features/ts-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"TypeScript release announcement, published 2025-02-28, reviewed 2026-07-26"},"2573":{"id":"/features/ts-computed-declaration-names-12","page_id":"/features/ts-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"TypeScript 5.8 release notes: Preserved Computed Property Names"},"2574":{"id":"/features/ts-computed-declaration-names-13","page_id":"/features/ts-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"2575":{"id":"/features/ts-computed-declaration-names-14","page_id":"/features/ts-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"TypeScript 5.8 stable release"},"2576":{"id":"/features/ts-computed-declaration-names-15","page_id":"/features/ts-computed-declaration-names","tags":[],"type":"text","url":"/features/ts-computed-declaration-names#sources","content":"Release tag, published 2025-02-28, reviewed 2026-07-23"},"2577":{"id":"/features/ts-computed-override-checks","page_id":"/features/ts-computed-override-checks","type":"page","content":"Computed property override checks","breadcrumbs":["typescript","TS 5.6"],"tags":[],"url":"/features/ts-computed-override-checks"},"2578":{"id":"/features/ts-computed-override-checks-0","page_id":"/features/ts-computed-override-checks","type":"heading","tags":[],"url":"/features/ts-computed-override-checks#computed-property-override-checks","content":"Computed property override checks"},"2579":{"id":"/features/ts-computed-override-check