the compatibility service."},"3159":{"id":"/features/ts-lsp-integration-boundary-10","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#related","content":"ts-native-compiler-api"},"3160":{"id":"/features/ts-lsp-integration-boundary-11","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"Announcing TypeScript 7.0 § editor-experience"},"3161":{"id":"/features/ts-lsp-integration-boundary-12","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"TypeScript release announcement, published 2026-07-08, reviewed 2026-07-23"},"3162":{"id":"/features/ts-lsp-integration-boundary-13","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"Announcing TypeScript 7.0 § typescript-and-embedded-languages"},"3163":{"id":"/features/ts-lsp-integration-boundary-14","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"TypeScript release announcement, published 2026-07-08, reviewed 2026-07-23"},"3164":{"id":"/features/ts-lsp-integration-boundary-15","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"typescript/v7.0.2 stable release"},"3165":{"id":"/features/ts-lsp-integration-boundary-16","page_id":"/features/ts-lsp-integration-boundary","tags":[],"type":"text","url":"/features/ts-lsp-integration-boundary#sources","content":"Release tag, published 2026-07-08, reviewed 2026-07-23"},"3166":{"id":"/features/ts-mandatory-stable-type-ordering","page_id":"/features/ts-mandatory-stable-type-ordering","type":"page","content":"Mandatory stable type ordering","breadcrumbs":["typescript","TS 7.0"],"tags":[],"ur