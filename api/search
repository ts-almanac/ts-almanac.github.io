s":[],"url":"/features/set-methods"},"2007":{"id":"/features/set-methods-0","page_id":"/features/set-methods","type":"heading","tags":[],"url":"/features/set-methods#set-methods","content":"Set methods"},"2008":{"id":"/features/set-methods-1","page_id":"/features/set-methods","type":"heading","tags":[],"url":"/features/set-methods#what-it-does","content":"What it does"},"2009":{"id":"/features/set-methods-2","page_id":"/features/set-methods","type":"heading","tags":[],"url":"/features/set-methods#before--after","content":"Before / after"},"2010":{"id":"/features/set-methods-3","page_id":"/features/set-methods","type":"heading","tags":[],"url":"/features/set-methods#gotchas","content":"Gotchas"},"2011":{"id":"/features/set-methods-4","page_id":"/features/set-methods","type":"heading","tags":[],"url":"/features/set-methods#sources","content":"Primary sources"},"2012":{"id":"/features/set-methods-5","page_id":"/features/set-methods","tags":[],"type":"text","url":"/features/set-methods#set-methods","content":"Set methods provide set algebra and relationship tests on built-in `Set` instances."},"2013":{"id":"/features/set-methods-6","page_id":"/features/set-methods","tags":[],"type":"text","url":"/features/set-methods#what-it-does","content":"`union`, `intersection`, `difference`, and `symmetricDifference` return new sets. `isSubsetOf`, `isSupersetOf`, and `isDisjointFrom` return booleans. Arguments can be set-like objects with `size`, `has`, and `keys` members."},"2014":{"id":"/features/set-methods-7","page_id":"/features/set-methods","tags":[],"type":"text","url":"/features/set-methods#gotchas","content":"The receiver must be an actual `Set`, but the argument uses the set-like protocol. Result ordering follows each method's specified iteration rules rather than sorting values."},"2015":{"id":"/features/set-methods-8","page_id":"/features/set-methods","tags":[],"type":"text","url":"/features/set-methods#sources","content":"Set Methods for JavaScript § proposal"},"2016":