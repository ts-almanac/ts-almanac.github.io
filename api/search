features/array-find-from-last","type":"heading","tags":[],"url":"/features/array-find-from-last#what-it-does","content":"What it does"},"38":{"id":"/features/array-find-from-last-2","page_id":"/features/array-find-from-last","type":"heading","tags":[],"url":"/features/array-find-from-last#before--after","content":"Before / after"},"39":{"id":"/features/array-find-from-last-3","page_id":"/features/array-find-from-last","type":"heading","tags":[],"url":"/features/array-find-from-last#gotchas","content":"Gotchas"},"40":{"id":"/features/array-find-from-last-4","page_id":"/features/array-find-from-last","type":"heading","tags":[],"url":"/features/array-find-from-last#sources","content":"Primary sources"},"41":{"id":"/features/array-find-from-last-5","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#arrayprototypefindlast-and-findlastindex","content":"Predicate searches run in descending index order and return the last matching element or its index without copying or reversing the receiver."},"42":{"id":"/features/array-find-from-last-6","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#what-it-does","content":"`findLast()` calls its predicate in descending index order and returns the matching element, or `undefined` when no call returns a truthy value. `findLastIndex()` returns the index of that element and `-1` when nothing matches. Both accept an optional `thisArg` and both are also installed on typed arrays, where `%TypedArray%.prototype.findLast` validates the receiver as a typed array before the search."},"43":{"id":"/features/array-find-from-last-7","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#gotchas","content":"The search reads every index in range rather than skipping absent ones, so a hole reaches the predicate as `undefined`: `[\"a\", , \"c\"].findLast((value) => value === undefined)` returns `undefined` after visiting index 1. FindViaPredicate gets each index and calls the predicate on the retrieved value."},"44":{"id":"/features/array-find-from-last-8","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"Array find from last proposal § core-features"},"45":{"id":"/features/array-find-from-last-9","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"TC39 proposal repository, reviewed 2026-07-26"},"46":{"id":"/features/array-find-from-last-10","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMAScript 2023: Array.prototype.findLast"},"47":{"id":"/features/array-find-from-last-11","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMA-262 specification, published 2023-06-27, reviewed 2026-07-26"},"48":{"id":"/features/array-find-from-last-12","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMAScript 2023: Array.prototype.findLastIndex"},"49":{"id":"/features/array-find-from-last-13","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMA-262 specification, published 2023-06-27, reviewed 2026-07-26"},"50":{"id":"/features/array-find-from-last-14","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMAScript 2023: FindViaPredicate"},"51":{"id":"/features/array-find-from-last-15","page_id":"/features/array-find-from-last","tags":[],"type":"text","url":"/features/array-find-from-last#sources","content":"ECMA-262 specification, published 2023-06-27, reviewed 2026-07-26"},"52":{"id":"/features/array-find-from-last-16","page_id":"/features/array-find