7","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#compatibility","content":"Code that assigned a conditional type to one branch based only on a generic constraint can now error. The resulting constraint is a union when future instantiations can select either branch."},"2616":{"id":"/features/ts-conditional-type-constraints-8","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"Announcing TypeScript 5.4"},"2617":{"id":"/features/ts-conditional-type-constraints-9","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"TypeScript release announcement, published 2024-03-06, reviewed 2026-07-26"},"2618":{"id":"/features/ts-conditional-type-constraints-10","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"TypeScript 5.4 release notes: conditional type constraints"},"2619":{"id":"/features/ts-conditional-type-constraints-11","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"TypeScript release notes, reviewed 2026-07-26"},"2620":{"id":"/features/ts-conditional-type-constraints-12","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"TypeScript 5.4 stable release"},"2621":{"id":"/features/ts-conditional-type-constraints-13","page_id":"/features/ts-conditional-type-constraints","tags":[],"type":"text","url":"/features/ts-conditional-type-constraints#sources","content":"Release tag, published 2024-03-06, reviewed 2026-07-26"},"2622":{"id":"/features/ts-config-dir-template","page_id":"/features/ts-config-dir-template","type":"page","