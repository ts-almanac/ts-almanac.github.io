","page_id":"/features/temporal-runtime-support","type":"heading","tags":[],"url":"/features/temporal-runtime-support#related","content":"Related"},"2326":{"id":"/features/temporal-runtime-support-5","page_id":"/features/temporal-runtime-support","type":"heading","tags":[],"url":"/features/temporal-runtime-support#sources","content":"Primary sources"},"2327":{"id":"/features/temporal-runtime-support-6","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#temporal-runtime-availability","content":"Temporal is available by default in the listed engines, while other engines require separate compatibility checks."},"2328":{"id":"/features/temporal-runtime-support-7","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#what-it-does","content":"Native implementations expose the `Temporal` namespace without a userland polyfill. Availability is independent of the proposal's annual-edition label."},"2329":{"id":"/features/temporal-runtime-support-8","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#gotchas","content":"Engine support does not guarantee identical time-zone or calendar data across deployments. Safari's compatibility record lists preview support behind a runtime flag, so it is not included as an unflagged support row."},"2330":{"id":"/features/temporal-runtime-support-9","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#support","content":"Engine or tool"},"2331":{"id":"/features/temporal-runtime-support-10","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#support","content":"Version"},"2332":{"id":"/features/temporal-runtime-support-11","page_id":"/features/temporal-runtime-support","tags":[],"type":"text","url":"/features/temporal-runtime-support#support","